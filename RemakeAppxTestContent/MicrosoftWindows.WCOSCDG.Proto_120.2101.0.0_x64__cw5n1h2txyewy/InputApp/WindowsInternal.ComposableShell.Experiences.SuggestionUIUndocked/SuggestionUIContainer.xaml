<UserControl x:ConnectionId='1'
    x:Class="WindowsInternal.ComposableShell.Experiences.SuggestionUIUndocked.SuggestionUIContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     
                                                                   
    AutomationProperties.AccessibilityView="Raw">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <!-- There are some situations Control's theme is different from Application's theme.  -->
        <!-- SystemColors need to be overridden in order to send correct colors to WebView. -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SuggestionUISystemAltHighColor" Color="{ThemeResource SystemAltHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAltLowColor" Color="{ThemeResource SystemAltLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAltMediumColor" Color="{ThemeResource SystemAltMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAltMediumHighColor" Color="{ThemeResource SystemAltMediumHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAltMediumLowColor" Color="{ThemeResource SystemAltMediumLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseHighColor" Color="{ThemeResource SystemBaseHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseLowColor" Color="{ThemeResource SystemBaseLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseMediumColor" Color="{ThemeResource SystemBaseMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseMediumHighColor" Color="{ThemeResource SystemBaseMediumHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseMediumLowColor" Color="{ThemeResource SystemBaseMediumLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeAltLowColor" Color="{ThemeResource SystemChromeAltLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeBlackHighColor" Color="{ThemeResource SystemChromeBlackHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeBlackLowColor" Color="{ThemeResource SystemChromeBlackLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeBlackMediumLowColor" Color="{ThemeResource SystemChromeBlackMediumLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeBlackMediumColor" Color="{ThemeResource SystemChromeBlackMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeDisabledHighColor" Color="{ThemeResource SystemChromeDisabledHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeDisabledLowColor" Color="{ThemeResource SystemChromeDisabledLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeHighColor" Color="{ThemeResource SystemChromeHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeLowColor" Color="{ThemeResource SystemChromeLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeMediumColor" Color="{ThemeResource SystemChromeMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeMediumLowColor" Color="{ThemeResource SystemChromeMediumLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeWhiteColor" Color="{ThemeResource SystemChromeWhiteColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemListLowColor" Color="{ThemeResource SystemListLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemListMediumColor" Color="{ThemeResource SystemListMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAccentColor" Color="{ThemeResource SystemAccentColor}" />
          <!-- Keep in sync with InputCompanionSuggestionUIPageBackgroundBrush in TextInput\HostApp\InputCompanionSuggestionUIPage.xaml -->
          <SolidColorBrush x:Key="SuggestionUIInputCompanionBackgroundColor" Color="#252525" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SuggestionUISystemAltHighColor" Color="{ThemeResource SystemAltHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAltLowColor" Color="{ThemeResource SystemAltLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAltMediumColor" Color="{ThemeResource SystemAltMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAltMediumHighColor" Color="{ThemeResource SystemAltMediumHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAltMediumLowColor" Color="{ThemeResource SystemAltMediumLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseHighColor" Color="{ThemeResource SystemBaseHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseLowColor" Color="{ThemeResource SystemBaseLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseMediumColor" Color="{ThemeResource SystemBaseMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseMediumHighColor" Color="{ThemeResource SystemBaseMediumHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemBaseMediumLowColor" Color="{ThemeResource SystemBaseMediumLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeAltLowColor" Color="{ThemeResource SystemChromeAltLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeBlackHighColor" Color="{ThemeResource SystemChromeBlackHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeBlackLowColor" Color="{ThemeResource SystemChromeBlackLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeBlackMediumLowColor" Color="{ThemeResource SystemChromeBlackMediumLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeBlackMediumColor" Color="{ThemeResource SystemChromeBlackMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeDisabledHighColor" Color="{ThemeResource SystemChromeDisabledHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeDisabledLowColor" Color="{ThemeResource SystemChromeDisabledLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeHighColor" Color="{ThemeResource SystemChromeHighColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeLowColor" Color="{ThemeResource SystemChromeLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeMediumColor" Color="{ThemeResource SystemChromeMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeMediumLowColor" Color="{ThemeResource SystemChromeMediumLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemChromeWhiteColor" Color="{ThemeResource SystemChromeWhiteColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemListLowColor" Color="{ThemeResource SystemListLowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemListMediumColor" Color="{ThemeResource SystemListMediumColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemAccentColor" Color="{ThemeResource SystemAccentColor}" />
          <!-- Keep in sync with InputCompanionSuggestionUIPageBackgroundBrush in TextInput\HostApp\InputCompanionSuggestionUIPage.xaml -->
          <SolidColorBrush x:Key="SuggestionUIInputCompanionBackgroundColor" Color="#DEDEDE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
          <SolidColorBrush x:Key="SuggestionUISystemColorButtonFaceColor" Color="{ThemeResource SystemColorButtonFaceColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemColorButtonTextColor" Color="{ThemeResource SystemColorButtonTextColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemColorGrayTextColor" Color="{ThemeResource SystemColorGrayTextColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemColorHighlightColor" Color="{ThemeResource SystemColorHighlightColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemColorHighlightTextColor" Color="{ThemeResource SystemColorHighlightTextColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemColorHotlightColor" Color="{ThemeResource SystemColorHotlightColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemColorWindowColor" Color="{ThemeResource SystemColorWindowColor}" />
          <SolidColorBrush x:Key="SuggestionUISystemColorWindowTextColor" Color="{ThemeResource SystemColorWindowTextColor}" />
          <SolidColorBrush x:Key="SuggestionUIInputCompanionBackgroundColor" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- Contents inside WebView sometimes flicker when the control resizes because XAML rendering and WebView rendering are not synchronized.
  The size of SuggestionUIContainer has to be always expanded size and clipped on the XAML side to show the part we want visible to avoid flickering.
  Specifically, we have to set TotalViewHeight and CollapsedViewHeight at least once. -->
  <RelativePanel x:ConnectionId='2' x:Name="RelativePanel"                                                          VerticalAlignment="Bottom">
    <Grid x:ConnectionId='3' x:Name="WebUIRoot" RelativePanel.AlignLeftWithPanel="true" RelativePanel.AlignRightWithPanel="true" RelativePanel.AlignTopWithPanel="true" RelativePanel.AlignBottomWithPanel="true">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition x:ConnectionId='5' x:Name="CollapsedViewRowDef"                                                                              />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ContentPresenter x:ConnectionId='6' x:Name="CollapsedViewLeftColumn"                                                                         Grid.Row="1" Grid.Column="0" Canvas.ZIndex="1"/>
      <!-- To enable gripping even if no webview is loaded, gripper is stretched to the parent width by default -->
      <Border x:ConnectionId='7' x:Name="GripperControl" Grid.Row="1" Grid.Column="1"                                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Canvas.ZIndex="1"/>
      <!-- WebView instance is loaded here in code - the reason for this is that you can only specify execution mode in WebView constructor -->
      <ContentPresenter x:ConnectionId='8' x:Name="CollapsedViewRightColumn"                                                                          Grid.Row="1" Grid.Column="2" Canvas.ZIndex="1"/>
    </Grid>
    <TextBox x:ConnectionId='4'
        x:Name="DelegationTextBox"
        Visibility="Collapsed"
        AllowDrop="false"
        PreventKeyboardDisplayOnProgrammaticFocus="true"
        IsHandwritingViewEnabled="false"
        CanDrag="false"
        RelativePanel.AlignLeftWithPanel="true"
        RelativePanel.AlignTopWithPanel="true"
        BorderThickness="0"
        Margin="0"
        Padding="0"
        AutomationProperties.AutomationId="SearchBox" >
    </TextBox>
  </RelativePanel>
</UserControl>

