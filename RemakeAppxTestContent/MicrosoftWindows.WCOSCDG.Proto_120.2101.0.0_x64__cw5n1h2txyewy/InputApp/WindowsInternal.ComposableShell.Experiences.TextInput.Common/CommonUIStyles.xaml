    <x:Double x:Key="FloatingContentControlTopHighlightHeight">1</x:Double>
    <x:Double x:Key="FloatingContentControlBorderThickness">1</x:Double>
    <Thickness x:Key="FloatingContentControlTopHighlightOffsetForBorder">0,1,0,0</Thickness>

