<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:WindowsInternal.ComposableShell.Experiences.TextInput.Common.ShellUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <common:FluentThemeResources/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="common:Grabber">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource FillContrastNeutralRestBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="common:Grabber">
                    <Grid Background="{TemplateBinding Background}">
                        <Rectangle
                            x:Name="Grip"
                            Fill="{TemplateBinding Foreground}"
                            Width="32"
                            Height="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RadiusX="1.5"
                            RadiusY="1.5"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

