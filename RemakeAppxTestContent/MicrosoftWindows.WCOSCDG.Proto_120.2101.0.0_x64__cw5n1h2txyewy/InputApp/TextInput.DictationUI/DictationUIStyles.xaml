<ResourceDictionary
    x:Class="TextInput.DictationUI.DictationUIStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TextInput.DictationUI"
    xmlns:common="using:WindowsInternal.ComposableShell.Experiences.TextInput.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Style x:Key="PrivacySettingsGridStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource PrivacySettingsBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PrivacySettingsBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="PrivacySettingsTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="AutomationProperties.AccessibilityView" Value="Content"/>
        <Setter Property="Margin" Value="24,20,24,12"/>
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
    </Style>

    <Style x:Key="PrivacySettingsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="AutomationProperties.AccessibilityView" Value="Content"/>
        <Setter Property="Margin" Value="24,0,24,16"/>
        <Setter Property="TextWrapping" Value="WrapWholeWords"/>
    </Style>

    <Style x:Key="PrivacySettingsHyperlinkButtonStyle" TargetType="HyperlinkButton">
        <Setter Property="AutomationProperties.AccessibilityView" Value="Control"/>
        <Setter Property="Margin" Value="24,0,24,12"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="PrivacySettingsButtonStyle" TargetType="Button">
        <Setter Property="AutomationProperties.AccessibilityView" Value="Control"/>
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{ThemeResource PrivacySettingsButtonBackground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:ConnectionId='2' x:Name="DefaultMicrophoneButtonStyle" TargetType="local:MicrophoneButton">
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="IsTextScaleFactorEnabled" Value="False" />
        <Setter Property="MicrophoneState" Value="Loading" />
        <Setter Property="MicrophoneBorderThickness" Value="2" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MicrophoneButton">
                    <Border x:Name="ButtonContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Listening">
                                    <VisualState.Setters>
                                        <Setter Target="MicrophoneIcon.Foreground" Value="{ThemeResource MicrophoneButtonForeground}" />
                                        <Setter Target="BorderCircle.Stroke" Value="{ThemeResource MicrophoneButtonForeground}" />
                                        <Setter Target="MicrophoneIcon.Glyph" Value="&#xEC71;" />
                                        <Setter Target="MicrophoneIcon.Visibility" Value="Visible" />
                                        <Setter Target="BorderCircle.Visibility" Value="Visible" />
                                        <Setter Target="LoadingRing.Visibility" Value="Collapsed" />
                                        <Setter Target="HearingStateInnerCircle.Visibility" Value="Collapsed" />
                                        <Setter Target="HearingStateOuterCircle.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Loading">
                                    <VisualState.Setters>
                                        <Setter Target="MicrophoneIcon.Foreground" Value="{ThemeResource MicrophoneButtonForeground}" />
                                        <Setter Target="BorderCircle.Stroke" Value="{ThemeResource MicrophoneButtonForeground}" />
                                        <Setter Target="MicrophoneIcon.Glyph" Value="&#xEC54;" />
                                        <Setter Target="MicrophoneIcon.Visibility" Value="Collapsed" />
                                        <Setter Target="BorderCircle.Visibility" Value="Collapsed" />
                                        <Setter Target="LoadingRing.Visibility" Value="Visible" />
                                        <Setter Target="HearingStateInnerCircle.Visibility" Value="Collapsed" />
                                        <Setter Target="HearingStateOuterCircle.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Paused">
                                    <VisualState.Setters>
                                        <Setter Target="MicrophoneIcon.Foreground" Value="{ThemeResource MicrophoneButtonPausedForeground}" />
                                        <Setter Target="BorderCircle.Stroke" Value="{ThemeResource MicrophoneButtonPausedForeground}" />
                                        <Setter Target="MicrophoneIcon.Glyph" Value="&#xEC71;" />
                                        <Setter Target="MicrophoneIcon.Visibility" Value="Visible" />
                                        <Setter Target="BorderCircle.Visibility" Value="Visible" />
                                        <Setter Target="LoadingRing.Visibility" Value="Collapsed" />
                                        <Setter Target="HearingStateInnerCircle.Visibility" Value="Collapsed" />
                                        <Setter Target="HearingStateOuterCircle.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Hearing">
                                    <VisualState.Setters>
                                        <Setter Target="MicrophoneIcon.Foreground" Value="{ThemeResource MicrophoneButtonForeground}" />
                                        <Setter Target="BorderCircle.Stroke" Value="{ThemeResource MicrophoneButtonForeground}" />
                                        <Setter Target="MicrophoneIcon.Glyph" Value="&#xEC71;" />
                                        <Setter Target="MicrophoneIcon.Visibility" Value="Visible" />
                                        <Setter Target="BorderCircle.Visibility" Value="Collapsed" />
                                        <Setter Target="LoadingRing.Visibility" Value="Collapsed" />
                                        <Setter Target="HearingStateInnerCircle.Visibility" Value="Visible" />
                                        <Setter Target="HearingStateOuterCircle.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HearingStateOuterCircle"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                            <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame Value="1.25" KeyTime="0:0:0.100">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HearingStateOuterCircle"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                            <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame Value="1.25" KeyTime="0:0:0.100">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HearingStateInnerCircle"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                            <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame Value="1.08" KeyTime="0:0:0.100">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HearingStateInnerCircle"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                            AutoReverse="True" RepeatBehavior="Forever">
                                            <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                            <EasingDoubleKeyFrame Value="1.08" KeyTime="0:0:0.100">
                                                <EasingDoubleKeyFrame.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut" />
                                                </EasingDoubleKeyFrame.EasingFunction>
                                            </EasingDoubleKeyFrame>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="ButtonGrid"
                                    Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}" 
                                    VerticalAlignment="{TemplateBinding VerticalAlignment}">
                            <ToolTipService.ToolTip>
                                <ToolTip x:Name="ButtonTooltip" />
                            </ToolTipService.ToolTip>
                            <!-- Don't remove the content presenter or button click stops working. -->
                            <ContentPresenter x:Name="ContentPresenter"
                                    Background="{TemplateBinding Background}"
                                    BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    AutomationProperties.AccessibilityView="Raw" />
                            <Ellipse x:Name="HearingStateOuterCircle"
                                     Stroke="{ThemeResource MicrophoneButtonHearingOuterCircleFill}"
                                     StrokeThickness="{TemplateBinding MicrophoneBorderThickness}"
                                     Fill="{ThemeResource MicrophoneButtonHearingOuterCircleFill}"
                                     RenderTransformOrigin="0.5, 0.5"
                                     AutomationProperties.AccessibilityView="Raw">
                                <Ellipse.RenderTransform>
                                    <CompositeTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="HearingStateInnerCircle"
                                     Stroke="{ThemeResource MicrophoneButtonHearingInnerCircleFill}"
                                     StrokeThickness="{TemplateBinding MicrophoneBorderThickness}"
                                     Fill="{ThemeResource MicrophoneButtonHearingInnerCircleFill}"
                                     RenderTransformOrigin="0.5, 0.5"
                                     AutomationProperties.AccessibilityView="Raw">
                                <Ellipse.RenderTransform>
                                    <CompositeTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="BorderCircle"
                                     Stroke="{ThemeResource MicrophoneButtonForeground}" 
                                     StrokeThickness="{TemplateBinding MicrophoneBorderThickness}"
                                     Fill="{ThemeResource MicrophoneButtonBackground}"
                                     AutomationProperties.AccessibilityView="Raw" />
                            <ProgressRing x:Name="LoadingRing"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     IsActive="True" />
                            <FontIcon x:Name="MicrophoneIcon" 
                                    FontFamily="Segoe MDL2 Assets"
                                    Glyph="&#xEC71;" FontSize="{TemplateBinding FontSize}"
                                    Foreground="{ThemeResource MicrophoneButtonForeground}"
                                    AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:MicrophoneButton" BasedOn="{StaticResource DefaultMicrophoneButtonStyle}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="MicrophoneBorderThickness" Value="4" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:ConnectionId='3' x:Name="LargeMicrophoneButtonStyle" TargetType="local:MicrophoneButton" BasedOn="{StaticResource DefaultMicrophoneButtonStyle}">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="MicrophoneBorderThickness" Value="4" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:ConnectionId='4' x:Name="DefaultInputPanelDictationControlStyle" TargetType="local:InputPanelDictationControl">
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:InputPanelDictationControl">
                    <Grid x:Name="Container"
                          Background="{ThemeResource InputPanelDictationControlBorder}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          BorderBrush="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.Transitions>
                            <TransitionCollection>
                                <PaneThemeTransition Edge="Bottom"/>
                            </TransitionCollection>
                        </Grid.Transitions>
                        <local:DictationSettingsFlyout x:Name="SettingsFlyout" />
                        <Popup x:Name="PrivacyPagePopup" ShouldConstrainToRootBounds="False">
                            <local:DictationPrivacySettings x:Name="PrivacyPage" />
                        </Popup>
                        <Grid Width="1" Height="1" Background="Transparent" x:Name="SettingsFlyoutTarget" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <RelativePanel x:Name="FloatyPanel"
                                  Background="{ThemeResource InputPanelDictationControlPanelBackground}"
                                  BorderThickness="{ThemeResource InputPanelDictationControlPanelBorderThickness}"
                                  BorderBrush="{ThemeResource InputPanelDictationControlPanelBorder}"
                                  Margin="{ThemeResource InputPanelDictationControlPanelMargin}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">

                            <common:InputIndicatorButton RelativePanel.AlignTopWithPanel="True"  RelativePanel.AlignRightWithPanel="True"
                                                             x:Name="InputSwitchingButton" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <common:InputSwitcher x:Name="InputSwitcher" PreferredPlacement="LeftBottom" Background="{ThemeResource InputPanelDictationControlBorder}" />

                            <local:MicrophoneButton x:Name="MicrophoneButton" RelativePanel.AlignHorizontalCenterWithPanel="True"
                                                        RelativePanel.AlignVerticalCenterWithPanel="True"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                        Margin="10" Style="{StaticResource LargeMicrophoneButtonStyle}" />

                            <common:TextButton x:Name="KeyboardButton" RelativePanel.AlignVerticalCenterWith="MicrophoneButton" RelativePanel.LeftOf="MicrophoneButton"
                                                   Style="{StaticResource KeyboardTextButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,32,0" />

                            <RepeatButton x:Name="BackspaceButton" RelativePanel.AlignVerticalCenterWith="MicrophoneButton" RelativePanel.RightOf="MicrophoneButton"
                                              Style="{StaticResource RepeatTextButtonStyle}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,0,0,0">
                                <RepeatButton.Content>
                                    <TextBlock Text="&#xE750;" FontFamily="Segoe MDL2 Assets" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                                </RepeatButton.Content>
                            </RepeatButton>

                            <ContentControl x:Name="TipTextBlockContainer" RelativePanel.AlignHorizontalCenterWith="MicrophoneButton" RelativePanel.Below="MicrophoneButton"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Top">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate                                      >
                                        <Grid x:ConnectionId='58' Padding="16,12,16,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid x:ConnectionId='60' Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"                                                     Margin="0,0,8,8">
                                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FontSize="16" Glyph="&#xF136;" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{ThemeResource FloatyTipErrorIconBackground}" />
                                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FontSize="16" Glyph="&#xF138;" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{ThemeResource FloatyTipErrorIconBorder}" />
                                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FontWeight="Bold" FontSize="16" Glyph="&#xF13C;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </Grid>

                                                <TextBlock x:ConnectionId='61' Grid.Column="1" x:Name="MainMessage"                                      FontSize="12" LineHeight="20" TextWrapping="WrapWholeWords"
                                                            FontFamily="XamlAutoFontFamily,Segoe MDL2 Assets,/Assets/Fonts/ECMDL2.ttf#EC MDL2 Assets" />
                                            </Grid>

                                            <Button x:ConnectionId='59' Grid.Row="1" x:Name="GotItButton" Margin="0,12,0,0"
                                                    MinHeight="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" 
                                                    VerticalContentAlignment="Center" ClickMode="Press"                                                                                          >
                                                <Button.Content>
                                                    <TextBlock x:Uid="GotItText" FontSize="12" LineHeight="16" />
                                                </Button.Content>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </RelativePanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:ConnectionId='5' x:Name="DesktopInputPanelDictationControlStyle" TargetType="local:InputPanelDictationControl">
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:InputPanelDictationControl">
                    <Grid x:Name="Container"
                          Background="{ThemeResource InputPanelDictationControlBorder}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          BorderBrush="{TemplateBinding Background}"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.Transitions>
                            <TransitionCollection>
                                <PaneThemeTransition Edge="Bottom"/>
                            </TransitionCollection>
                        </Grid.Transitions>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="40" Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <local:DictationSettingsFlyout x:Name="SettingsFlyout" />
                        <Grid x:Name="Gripper" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Background="Transparent" />
                        <RelativePanel Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <common:TextButton x:Name="SettingsFlyoutButton" RelativePanel.AlignLeftWithPanel="True" RelativePanel.AlignTopWithPanel="True"
                                       Background="Transparent" ClickMode="Press" IsTextScaleFactorEnabled="False"
                                       Style="{StaticResource SettingsTextButtonStyle}" />

                            <common:TextButton x:Name="CloseButton" RelativePanel.AlignTopWithPanel="True" RelativePanel.AlignRightWithPanel="True"
                                       Background="Transparent" ClickMode="Press" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       FontSize="16" Style="{StaticResource CloseTextButtonStyle}" IsTextScaleFactorEnabled="False" />

                        </RelativePanel>
                        <RelativePanel x:Name="FloatyPanel" Grid.Row="1"
                                  Background="{ThemeResource InputPanelDictationControlPanelBackground}"
                                  BorderThickness="{ThemeResource InputPanelDictationControlPanelBorderThickness}"
                                  BorderBrush="{ThemeResource InputPanelDictationControlPanelBorder}"
                                  Margin="{ThemeResource InputPanelDictationControlPanelMargin}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">

                            <common:InputIndicatorButton RelativePanel.AlignTopWithPanel="True"  RelativePanel.AlignRightWithPanel="True"
                                                             x:Name="InputSwitchingButton" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            <common:InputSwitcher x:Name="InputSwitcher" PreferredPlacement="LeftBottom" Background="{ThemeResource InputPanelDictationControlBorder}" />

                            <local:MicrophoneButton x:Name="MicrophoneButton" RelativePanel.AlignHorizontalCenterWithPanel="True"
                                                        RelativePanel.AlignVerticalCenterWithPanel="True"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                        Margin="10" Style="{StaticResource LargeMicrophoneButtonStyle}" />

                            <common:TextButton x:Name="KeyboardButton" RelativePanel.AlignVerticalCenterWith="MicrophoneButton" RelativePanel.LeftOf="MicrophoneButton"
                                                   Style="{StaticResource KeyboardTextButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,32,0" />

                            <RepeatButton x:Name="BackspaceButton" RelativePanel.AlignVerticalCenterWith="MicrophoneButton" RelativePanel.RightOf="MicrophoneButton"
                                              Style="{StaticResource RepeatTextButtonStyle}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32,0,0,0">
                                <RepeatButton.Content>
                                    <TextBlock Text="&#xE750;" FontFamily="Segoe MDL2 Assets" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                                </RepeatButton.Content>
                            </RepeatButton>

                            <ContentControl x:Name="TipTextBlockContainer" RelativePanel.AlignHorizontalCenterWith="MicrophoneButton" RelativePanel.Below="MicrophoneButton"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Top">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate                                      >
                                        <Grid x:ConnectionId='39' Padding="16,12,16,12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid x:ConnectionId='41' Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"                                                     Margin="0,0,8,8">
                                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FontSize="16" Glyph="&#xF136;" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{ThemeResource FloatyTipErrorIconBackground}" />
                                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FontSize="16" Glyph="&#xF138;" FontFamily="{StaticResource SymbolThemeFontFamily}" Foreground="{ThemeResource FloatyTipErrorIconBorder}" />
                                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FontWeight="Bold" FontSize="16" Glyph="&#xF13C;" FontFamily="{StaticResource SymbolThemeFontFamily}" />
                                                </Grid>

                                                <TextBlock x:ConnectionId='42' Grid.Column="1" x:Name="MainMessage"                                      FontSize="12" LineHeight="20" TextWrapping="WrapWholeWords"
                                                            FontFamily="XamlAutoFontFamily,Segoe MDL2 Assets,/Assets/Fonts/ECMDL2.ttf#EC MDL2 Assets" />
                                            </Grid>

                                            <Button x:ConnectionId='40' Grid.Row="1" x:Name="GotItButton" Margin="0,12,0,0"
                                                    MinHeight="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" 
                                                    VerticalContentAlignment="Center" ClickMode="Press"                                                                                          >
                                                <Button.Content>
                                                    <TextBlock x:Uid="GotItText" FontSize="12" LineHeight="16" />
                                                </Button.Content>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </RelativePanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:InputPanelDictationControl" BasedOn="{StaticResource DefaultInputPanelDictationControlStyle}" />

    <Style x:Key="SettingFlyoutFloatingStyle" TargetType="common:FloatingContentControl" BasedOn="{StaticResource DefaultAlignedPopupStyle}">
        <Setter Property="PreferredPlacements">
            <Setter.Value>
                <common:FloatingContentControlPlacementMode>TopRight</common:FloatingContentControlPlacementMode>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="common:FloatingContentControl">
                    <Popup x:Name="Popup" ShouldConstrainToRootBounds="{TemplateBinding ShouldConstrainToRootBounds}"
                           AutomationProperties.Name="{TemplateBinding AccessibleMessage}"
                           AutomationProperties.AutomationId="{TemplateBinding AccessibleId}">
                        <Border x:Name="Container"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="Transparent">
                            <Grid x:Name="ContentRootGrid"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  MaxHeight="{TemplateBinding MaxHeight}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}"/>
                            </Grid>
                        </Border>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultDictationSettingsFlyoutStyle" TargetType="local:DictationSettingsFlyout">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DictationSettingsFlyout">
                    <common:FloatingContentControl x:Name="SettingsFlyoutControl" ShouldConstrainToRootBounds="False" Style="{StaticResource SettingFlyoutFloatingStyle}" AccessibleId="SettingFlyoutFloaty">
                        <ContentControl.ContentTemplate>
                            <DataTemplate                                              >
                                <ListView x:ConnectionId='9' x:Name="ItemList" MinHeight="165" MinWidth="228"
                                          Margin="0" SelectionMode="None" IsItemClickEnabled="True"
                                          ScrollViewer.HorizontalScrollMode="Auto"
                                          ScrollViewer.VerticalScrollMode="Auto"
                                          CornerRadius="{ThemeResource OverlayCornerRadius}" BorderThickness="{ThemeResource SettingFlyoutBorderThickness}"
                                                                                   
                                          Background="{ThemeResource SettingFlyoutBackgroundColor}"
                                          BorderBrush="{ThemeResource SettingFlyoutBorderColor}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource TransparentListViewItemStyle}" />
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate                                             >
                                            <Grid x:ConnectionId='11'>
                                                <Grid x:ConnectionId='12' x:Name="SettingsItem" Background="Transparent"                                      MinHeight="40">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" x:Name="IconColumn"/>
                                                        <ColumnDefinition Width="Auto" x:Name="LabelColumn"/>
                                                        <ColumnDefinition Width="Auto" x:Name="ToggleSwitchColumn"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon x:ConnectionId='17' x:Name="Icon" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" MinWidth="28" FontFamily="Segoe MDL2 Assets"                           />
                                                    <TextBlock x:ConnectionId='18' x:Name="Description" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="144"                                   />
                                                    <ToggleSwitch x:ConnectionId='19' Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="56" OnContent="" OffContent=""                                                           
                                                                                                               />
                                                </Grid>
                                                <Grid x:ConnectionId='13' x:Name="PseudoSeparaterRoot" Background="Transparent"                                               Height="5">
