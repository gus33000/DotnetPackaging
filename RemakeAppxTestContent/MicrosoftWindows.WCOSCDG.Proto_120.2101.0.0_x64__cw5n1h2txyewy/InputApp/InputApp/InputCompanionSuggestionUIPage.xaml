<Page x:ConnectionId='1'
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.InputApp.InputCompanionSuggestionUIPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.InputApp"
    xmlns:controls="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suggestionui="using:WindowsInternal.ComposableShell.Experiences.SuggestionUIUndocked"
                                                   
                                                       
    VerticalAlignment="Bottom"
    mc:Ignorable="d">

    <!-- Keep InputCompanionSuggestionUIPageBackgroundBrush in sync with SuggestionUIInputCompanionBackgroundColor in shellcommon\Composable\Components\SuggestionUI\dll\SuggestionUIContainer.xaml -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="InputCompanionSuggestionUIPageBackgroundBrush" Color="#252525" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="InputCompanionSuggestionUIPageBackgroundBrush" Color="#DEDEDE" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="InputCompanionSuggestionUIPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- refer a comment about control's size in \shellcommon\Composable\Components\SuggestionUI\dll\SuggestionUIContainer.xaml -->
    <suggestionui:SuggestionUIContainer x:ConnectionId='2' x:Name="SuggestionUIControl" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0" ViewHostType="InputCompanion">
        <suggestionui:SuggestionUIContainer.CollapsedViewLeftColumnTemplate>
            <DataTemplate                                                  >
                <StackPanel x:ConnectionId='4'
                    Orientation="Horizontal"
                                                                        
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Padding="4,4,4,16"
                    Background="{ThemeResource InputCompanionSuggestionUIPageBackgroundBrush}">
                    <controls:SimpleButton x:ConnectionId='5' x:Name="KeyboardSettingsMenuButton"  
                                           FontFamily="Segoe MDL2 Assets"
                                           ButtonText="&#xE713;"
                                                                                    
                                           Style="{StaticResource ModernUXSuggestionUIButtonStyle}" 
                                                                                                 
                                           AutomationProperties.AutomationId="KeyboardSettingsMenuButton"
                                                                                                              />   
                    <controls:SimpleButton x:ConnectionId='6' x:Name="ToggleViewStateButton"
                                           FontFamily="{StaticResource FontFamilyESIPMDL2}"
                                           ButtonText="&#xF6B8;"
                                                                                 
                                           Margin="4,0,0,0"
                                           Style="{StaticResource ModernUXSuggestionUIButtonStyle}"
                                                                                                         
                                                                                                            />
                </StackPanel>
            </DataTemplate>
        </suggestionui:SuggestionUIContainer.CollapsedViewLeftColumnTemplate>
    </suggestionui:SuggestionUIContainer>

</Page>

