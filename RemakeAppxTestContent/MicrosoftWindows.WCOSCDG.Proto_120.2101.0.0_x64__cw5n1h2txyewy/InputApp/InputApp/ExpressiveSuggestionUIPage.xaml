<Page x:ConnectionId='1'
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.InputApp.ExpressiveSuggestionUIPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.InputApp"
    xmlns:controls="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls"
    xmlns:shellUI="using:WindowsInternal.ComposableShell.Experiences.TextInput.Common.ShellUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suggestionui="using:WindowsInternal.ComposableShell.Experiences.SuggestionUIUndocked"
                                               
                                                   
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="FloatingSuggestionUIBackgroundAcrylicBrush" BackgroundSource="Backdrop" TintColor="#1B1B1B" FallbackColor="#1B1B1B" TintOpacity="0.3" />
                    <SolidColorBrush x:Key="FloatingSuggestionUICloseButtonBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="FloatingSuggestionUIBackgroundAcrylicBrush" BackgroundSource="Backdrop" TintColor="#D3D3D3" FallbackColor="#D3D3D3" TintOpacity="0.3" />
                    <SolidColorBrush x:Key="FloatingSuggestionUICloseButtonBrush" Color="#101010" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="FloatingSuggestionUIBackgroundAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="FloatingSuggestionUICloseButtonBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <GridLength x:Key="ExpressiveInputGrabberHeight">32</GridLength>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid CornerRadius="{StaticResource ControlLargeCornerRadius}">
        <shellUI:ThemeDropShadow x:ConnectionId='2'                                    Kind="AppToApp"/>
        <Grid x:ConnectionId='3' x:Name="SuggestionUIGrid" Background="{ThemeResource FloatingSuggestionUIBackgroundAcrylicBrush}" Margin="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource ExpressiveInputGrabberHeight}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <shellUI:Grabber x:ConnectionId='5'
                    x:Name="Grabber"
                    Grid.Row="0"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Control.IsTemplateFocusTarget="True"
                    IsHitTestVisible="True"/>
                <Button x:ConnectionId='6' x:Name="SuggestionUIContainerCloseButton"
                    Content="&#59540;"
                    Width="16"
                    Height="16"
                    Padding="0"
                    FontSize="10"
                    Margin="0,8,16,0"
                    FontFamily="Segoe MDL2 Assets"
                    Foreground="{ThemeResource FloatingSuggestionUICloseButtonBrush}"
                    Background="Transparent"
                                                
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="CloseButton"
                    AutomationProperties.Name="CloseButtonName" />
            </Grid>
            <Grid Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <suggestionui:SuggestionUIContainer x:ConnectionId='4' x:Name="SuggestionUIControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" ViewHostType="ExpressiveInput" ViewVariant="Floating"/>
            </Grid>
        </Grid>
    </Grid>
</Page>

