    <!-- *********************************** Clipboard control listView item style *********************************** -->
    <Style x:Key="ClipboardListViewItemStyle" TargetType="clipboard:ClipboardListViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="16,8,16,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- template for listviewitem is based on https://msdn.microsoft.com/en-us/library/windows/apps/mt299136.aspx then stripped of unnecessary stuff like dragging/multiselect etc + some UI tree/VSM/style modifications -->
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="InnerBorderBackground.BorderBrush" Value="{ThemeResource ClipboardControlListViewItemPointerOverInnerBorderBrush}" />
                                        <Setter Target="InnerBorderBackground.BorderThickness" Value="{StaticResource ClipboardListViewItemInnerBorderBackgroundThickness}" />
                                        <Setter Target="BorderBackground.BorderBrush" Value="{ThemeResource ClipboardControlListViewItemPointerOverBorderBrush}" />
                                        <Setter Target="BorderBackground.BorderThickness" Value="{StaticResource ClipboardListViewItemBorderBackgroundThickness}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="InnerBorderBackground.BorderBrush" Value="{ThemeResource ClipboardControlListViewItemSelectedItemInnerBorderBrush}" />
                                        <Setter Target="InnerBorderBackground.BorderThickness" Value="{StaticResource ClipboardListViewItemInnerBorderBackgroundThickness}" />
                                        <Setter Target="BorderBackground.BorderBrush" Value="{ThemeResource ClipboardControlListViewItemSelectedItemBorderBrush}" />
                                        <Setter Target="BorderBackground.BorderThickness" Value="{StaticResource ClipboardListViewItemBorderBackgroundThickness}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="InnerBorderBackground.BorderBrush" Value="{ThemeResource ClipboardControlListViewItemSelectedItemInnerBorderBrush}" />
                                        <Setter Target="InnerBorderBackground.BorderThickness" Value="{StaticResource ClipboardListViewItemInnerBorderBackgroundThickness}" />
                                        <Setter Target="BorderBackground.BorderBrush" Value="{ThemeResource ClipboardControlListViewItemSelectedItemBorderBrush}" />
                                        <Setter Target="BorderBackground.BorderThickness" Value="{StaticResource ClipboardListViewItemBorderBackgroundThickness}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="ContentPresenterGrid"
                              Background="{ThemeResource ClipboardControlListViewItemDefaultBackgroundBrush}"
                              Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{StaticResource ClipboardListViewItemActionButtonWidth}"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Grid.Column="0"
                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>

                            <StackPanel x:Name="TEMPLATE_PART_ButtonsStackPanel" Orientation="Vertical" Margin="0,12,0,0" Grid.Column="1" Visibility="Collapsed">
                                <controls:SimpleButton x:Name="TEMPLATE_PART_DeleteButton" Width="{StaticResource ClipboardListViewItemActionButtonWidth}" Height="{StaticResource ClipboardListViewItemActionButtonHeight}"
                                                       Content="&#xE711;" Visibility="Collapsed" ToolTipService.Placement="Mouse">
                                    <ToolTipService.ToolTip>
                                        <clipboard:ClipboardToolTip x:Name="TEMPLATE_PART_DeleteItemToolTip" Style="{StaticResource DefaultClipboardToolTip}"/>
                                    </ToolTipService.ToolTip>
                                </controls:SimpleButton>
                                <controls:SimpleButton x:Name="TEMPLATE_PART_PinButton" Width="{StaticResource ClipboardListViewItemActionButtonWidth}" Height="{StaticResource ClipboardListViewItemActionButtonHeight}"
                                                       Margin="0,12,0,0" Visibility="Collapsed" ToolTipService.Placement="Mouse">
                                    <ToolTipService.ToolTip>
                                        <clipboard:ClipboardToolTip x:Name="TEMPLATE_PART_PinItemToolTip" Style="{StaticResource DefaultClipboardToolTip}"/>
                                    </ToolTipService.ToolTip>
                                </controls:SimpleButton>
                                <controls:SimpleButton x:Name="TEMPLATE_PART_UploadButton" Width="{StaticResource ClipboardListViewItemActionButtonWidth}" Height="{StaticResource ClipboardListViewItemActionButtonHeight}"
                                                       Margin="0,12,0,0" Content="&#xEC8E;" Visibility="Collapsed" ToolTipService.Placement="Mouse">
                                    <ToolTipService.ToolTip>
                                        <clipboard:ClipboardToolTip x:Name="TEMPLATE_PART_UploadItemToolTip" Style="{StaticResource DefaultClipboardToolTip}"/>
                                    </ToolTipService.ToolTip>
                                </controls:SimpleButton>
                            </StackPanel>
                        </Grid>

                        <!-- highlight borders -->
                        <Border x:Name="InnerBorderBackground" BorderThickness="0"/>
                        <Border x:Name="BorderBackground" BorderThickness="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

