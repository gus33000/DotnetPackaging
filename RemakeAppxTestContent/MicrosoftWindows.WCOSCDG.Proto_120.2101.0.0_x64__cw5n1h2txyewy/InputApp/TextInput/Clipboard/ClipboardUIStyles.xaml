                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- *********************************** Clipboard control listView item action button style *********************************** -->
    <Style x:Key="ClipboardListViewItemActionButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" BorderThickness="1">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush" Storyboard.TargetName="RootGrid">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewItemActionButtonBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="Label">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewItemActionButtonHoverForeground}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush" Storyboard.TargetName="RootGrid">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewItemActionButtonHoverBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="Label">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewItemActionButtonPressedForeground}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush" Storyboard.TargetName="RootGrid">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewItemActionButtonPressedBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="Transparent"/>
                        <TextBlock x:Name="Label"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding Content}"
                                   FontSize="12"
                                   Foreground="{ThemeResource ClipboardControlListViewItemActionButtonForeground}"
                                   FontFamily="{StaticResource AXPMDL2Assets}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- *********************************** Clipboard control listView image item action button style *********************************** -->
    <Style x:Key="ClipboardListViewImageItemActionButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" BorderThickness="1">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush" Storyboard.TargetName="RootGrid">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewItemActionButtonBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="Label">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewImageItemActionButtonHoverForeground}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush" Storyboard.TargetName="RootGrid">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewItemActionButtonHoverBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="Label">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewImageItemActionButtonPressedForeground}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush" Storyboard.TargetName="RootGrid">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ClipboardControlListViewItemActionButtonPressedBorderBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Fill="Transparent"/>
                        <TextBlock x:Name="Label"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding Content}"
                                   FontSize="12"
                                   Foreground="{ThemeResource ClipboardControlListViewImageItemActionButtonForeground}"
                                   FontFamily="{StaticResource AXPMDL2Assets}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- *********************************** ClipboardToolTip default style *********************************** -->
    <Style x:Key="DefaultClipboardToolTip" TargetType="clipboard:ClipboardToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="clipboard:ClipboardToolTip">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{TemplateBinding CaptionText}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="Bold"/>
                        <TextBlock Text="{TemplateBinding BodyText}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- *********************************** element styles for below data templates *********************************** -->
    <Style x:Key="DefaultClipboardItemTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{ThemeResource ClipboardControlListViewItemTextForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="MaxHeight" Value="60" />
    </Style>

    <Style x:Key="NarrowClipboardItemTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{ThemeResource ClipboardControlListViewItemTextForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="MaxHeight" Value="48" />
        <Setter Property="MaxWidth" Value="212" />
    </Style>

    <Style x:Key="DefaultIconStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{StaticResource AXPMDL2Assets}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{ThemeResource ClipboardControlListViewItemTextForegroundBrush}" />
    </Style>

    <Style x:Key="DefaultClipboardItemFooterStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{ThemeResource ClipboardControlListViewItemFooterTextForegroundBrush}" />
    </Style>

    <!-- *********************************** data templates for suggestion list/selector menu items *********************************** -->
    <!-- TODO: additional work on defining templates here -->
    <DataTemplate x:Key="FallbackClipboardItemTemplate"                                         >
        <Grid Padding="12,20,12,16">
            <TextBlock Text="Unknown Clipboard Item!" Style="{StaticResource DefaultClipboardItemTextStyle}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TextClipboardItemTemplate"                                         >
        <Grid x:ConnectionId='32' Padding="12,20,12,16" Height="128">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock x:ConnectionId='33'                                   Grid.Row="0" Style="{StaticResource DefaultClipboardItemTextStyle}"/>
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Orientation="Horizontal">
                <!-- Icon -->
                <TextBlock x:ConnectionId='34'                                   Style="{StaticResource DefaultIconStyle}" Padding="0,0,12,0"                                                    >
                    <ToolTipService.ToolTip>
                        <ToolTip x:ConnectionId='36'                                       Placement="Mouse"/>
                    </ToolTipService.ToolTip>
                </TextBlock>
                <!-- Timestamp -->
                <TextBlock x:ConnectionId='35'                                        Style="{StaticResource DefaultClipboardItemFooterStyle}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImageClipboardItemTemplate"                                         >
        <Grid x:ConnectionId='26' Margin="{StaticResource ClipboardListViewImageItemMargin}">
            <Image x:ConnectionId='27'                                      Stretch="None" MaxHeight="128"/>
            <!-- dark and semi-transparent overlay -->
            <Rectangle Height="128" Fill="{ThemeResource ClipboardControlListViewImageItemOverlayBackgroundBrush}"/>
            <Grid VerticalAlignment="Bottom" Margin="12,0,12,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <!-- Icon -->
                    <TextBlock x:ConnectionId='28'                                   Style="{StaticResource DefaultIconStyle}"
                               Foreground="{ThemeResource ClipboardControlListViewImageItemTextForegroundBrush}" Padding="0,0,12,0"
                                                                                  >
                        <ToolTipService.ToolTip>
                            <ToolTip x:ConnectionId='30'                                       Placement="Mouse"/>
                        </ToolTipService.ToolTip>
                    </TextBlock>
                    <!-- Timestamp -->
                    <TextBlock x:ConnectionId='29'                                        Style="{StaticResource DefaultClipboardItemFooterStyle}"
                               Foreground="{ThemeResource ClipboardControlListViewImageItemTextForegroundBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TextClipboardItemNarrowTemplate"                                         >
        <Grid x:ConnectionId='23' Padding="12,8,12,12" Height="68">
            <TextBlock x:ConnectionId='24'                                   Style="{StaticResource NarrowClipboardItemTextStyle}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ImageClipboardItemNarrowTemplate"                                         >
        <Grid x:ConnectionId='20' Margin="{StaticResource ClipboardListViewImageItemMargin}" Padding="4,4,0,4" Height="68">
            <Image x:ConnectionId='21'                                      Stretch="None" MaxHeight="60" MaxWidth="220" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </Grid>
    </DataTemplate>

    <clipboard:ClipboardItemDataTemplateSelector x:Key="ClipboardItemDataTemplateSelector"
                                                 FallbackTemplate="{StaticResource FallbackClipboardItemTemplate}"
                                                 TextTemplate="{StaticResource TextClipboardItemTemplate}"
                                                 ImageTemplate="{StaticResource ImageClipboardItemTemplate}"
                                                 TextNarrowTemplate="{StaticResource TextClipboardItemNarrowTemplate}"
                                                 ImageNarrowTemplate="{StaticResource ImageClipboardItemNarrowTemplate}"
                                                 />

    <!-- *********************************** element styles for below data templates *********************************** -->
    <Style x:Key="ClipboardControlTipFooterTextStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{ThemeResource ClipboardControlTipFooterForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style x:Key="ClipboardControlTipFooterSmallerTextStyle"  BasedOn="{StaticResource ClipboardControlTipFooterTextStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="ClipboardControlTipFooterRichTextStyle" TargetType="RichTextBlock">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{ThemeResource ClipboardControlTipFooterForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style x:Key="ClipboardControlTipFooterSmallerRichTextStyle"  BasedOn="{StaticResource ClipboardControlTipFooterRichTextStyle}" TargetType="RichTextBlock">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- *********************************** data templates for tip footer item/selector items *********************************** -->
    <DataTemplate x:Key="FallbackClipboardTipTemplate"                                    >
        <Grid/>
    </DataTemplate>

    <DataTemplate x:Key="ShellHotkeyPromotionClipboardTipTemplate"                                    >
        <Grid x:ConnectionId='15'>
            <TextBlock x:ConnectionId='16'                                                                         />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="CloudPromotionClipboardTipTemplate"                                    >
        <Grid x:ConnectionId='3'>
            <RichTextBlock x:ConnectionId='4'                                        >
                <Paragraph>
                    <Run x:ConnectionId='5'                                     />
                    <InlineUIContainer>
                        <StackPanel>
                            <Grid x:ConnectionId='6'                                                                                                                                                 
                                  BorderBrush="{ThemeResource ClipboardControlTipFooterBackgroundBrush}"
                                  BorderThickness = "1"
                                  Margin="0,0,0,-4">
                                <TextBlock x:ConnectionId='11'                                    >
                                   <Span xml:space="preserve"><Hyperlink x:ConnectionId='12'                                       ><Run x:ConnectionId='13'                                          /></Hyperlink></Span>
                                </TextBlock>
                            </Grid>
                            <Grid x:ConnectionId='7'                                                             
                                  BorderBrush="{ThemeResource ClipboardControlListViewItemSelectedItemBorderBrush}"
                                  BorderThickness = "1"
                                  Margin="0,0,0,-4">
                                <TextBlock x:ConnectionId='8'                                    >
                                   <Span xml:space="preserve"><Hyperlink x:ConnectionId='9'                                       ><Run x:ConnectionId='10'                                          /></Hyperlink></Span>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </InlineUIContainer>
                </Paragraph>
            </RichTextBlock>
        </Grid>
    </DataTemplate>

    <clipboard:ClipboardTipDataTemplateSelector x:Key="ClipboardTipDataTemplateSelector"
                                                FallbackTemplate="{StaticResource FallbackClipboardTipTemplate}"
                                                ShellHotkeyPromotionTemplate="{StaticResource ShellHotkeyPromotionClipboardTipTemplate}"
                                                CloudPromotionTemplate="{StaticResource CloudPromotionClipboardTipTemplate}"/>

</ResourceDictionary>

