    <!-- *********************************** Clipboard control static resources *********************************** -->
    <x:String x:Key="ClipboardListViewItemInnerBorderBackgroundThickness">4</x:String>
    <x:String x:Key="ClipboardListViewItemBorderBackgroundThickness">2</x:String>
    <x:String x:Key="ClipboardControlTitleBarHeight">40</x:String>
    <x:String x:Key="AXPMDL2Assets">ms-resource:///Files/InputApp/Assets/Fonts/AXPMDL2.ttf#AXP MDL2 Assets,/Assets/Fonts/AXPMDL2.ttf#AXP MDL2 Assets</x:String>
    <x:String x:Key="ClipboardListViewImageItemMargin">0,0,-32,0</x:String> <!-- note: this 32 should keep consistent as the below width 32 -->
    <x:String x:Key="ClipboardListViewItemActionButtonWidth">32</x:String>
    <x:String x:Key="ClipboardListViewItemActionButtonHeight">18</x:String>
    <converter:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    <!-- *********************************** Clipboard control container style *********************************** -->
    <Style x:Key="ClipboardControlContainerStyle" TargetType="clipboard:ClipboardControlContainer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="clipboard:ClipboardControlContainer">
                    <clipboard:ClipboardControl x:Name="TEMPLATE_PART_ClipboardControl" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                IsTextScaleFactorEnabled="False"
                                                Style="{StaticResource StandaloneClipboardControlStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- *********************************** Clipboard control style *********************************** -->
    <Style x:Key="StandaloneClipboardControlStyle" TargetType="clipboard:ClipboardControl">
        <Setter Property="Background" Value="{ThemeResource ClipboardControlBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="clipboard:ClipboardControl">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource ClipboardControlTitleBarHeight}"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock x:Name="TEMPLATE_PART_ClipboardTitleBar"
                                       Style="{StaticResource ClipboardControlTitleBarTextStyle}"/>
                            <controls:SimpleButton x:Name="TEMPLATE_PART_ClearAll"
                                                   Style="{StaticResource ClipboardClearAllButtonStyle}">
                                <ToolTipService.ToolTip>
                                    <clipboard:ClipboardToolTip x:Name="TEMPLATE_PART_ClearAllToolTip" Style="{StaticResource DefaultClipboardToolTip}"/>
                                </ToolTipService.ToolTip>
                            </controls:SimpleButton>
                            <Button x:Name="TEMPLATE_PART_CloseButton"
                                    Style="{StaticResource ClipboardControlTipPanelCloseButtonStyle}"
                                    Visibility="Collapsed"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <clipboard:ClipboardListView x:Name="TEMPLATE_PART_ClipboardItemsList"
                                                         Grid.Row="0" Grid.Column="0"
                                                         Style="{StaticResource ClipboardItemsListStyle}">
                            </clipboard:ClipboardListView>

                            <ProgressRing x:Name="TEMPLATE_PART_ClipboardProgressUI" Width="100" Height="100" IsActive="False" Visibility="Collapsed" />
                            <!-- This Tip Panel is used in empty case, while Tip Footer below is for promoting -->
                            <Grid x:Name="TEMPLATE_PART_ClipboardTipPanel" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="16,30,16,0">
                                    <TextBlock Text="&#xF6DE;"
                                               FontFamily="{StaticResource AXPMDL2Assets}"
                                               FontSize="80"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource ClipboardControlTipPanelIconForegroundBrush}"/>
                                    <TextBlock x:Name="TEMPLATE_PART_ClipboardTipCaptionTextBlock"
                                               FontSize="21"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource ClipboardControlTipPanelTextForegroundBrush}"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Margin="0,24,0,0"/>
                                    <TextBlock x:Name="TEMPLATE_PART_ClipboardTipBodyTextBlock"
                                               FontSize="15"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource ClipboardControlTipPanelTextForegroundBrush}"
                                               FontWeight="Normal"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"/>
                                    <clipboard:ClipboardTurnOnButton x:Name="TEMPLATE_PART_ClipboardTurnOnButton" Style="{StaticResource ClipboardControlTurnOnButtonStyle}" Visibility="Collapsed"
                                                                     Margin="0,24,0,0">
                                        <TextBlock x:Name="TEMPLATE_PART_ClipboardTurnOnTextBlock"
                                               FontSize="15"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               FontWeight="Normal"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,0"/>
                                    </clipboard:ClipboardTurnOnButton>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="TEMPLATE_PART_ClipboardTipFooter"
                                  Padding="16,5,16,5"
                                  Background="{ThemeResource ClipboardControlTipFooterBackgroundBrush}"
                                  VerticalAlignment="Bottom"
                                  Visibility="Collapsed">
                                <ContentControl x:Name="TEMPLATE_PART_ClipboardTipFooterContentControl"
                                                ContentTemplateSelector="{StaticResource ClipboardTipDataTemplateSelector}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- *********************************** Small Clipboard control style *********************************** -->
    <Style x:Key="SmallClipboardControlStyle" TargetType="clipboard:ClipboardControl">
        <Setter Property="Background" Value="{ThemeResource ClipboardControlBackgroundBrush}" />
        <Setter Property="Template">
