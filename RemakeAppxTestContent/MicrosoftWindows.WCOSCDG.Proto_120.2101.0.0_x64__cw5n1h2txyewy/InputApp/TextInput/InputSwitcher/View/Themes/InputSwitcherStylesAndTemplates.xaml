<ResourceDictionary
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.InputSwitcherStylesAndTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked"
    xmlns:controls="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <x:Double x:Key="SymbolFontSize">24</x:Double>
    <x:Double x:Key="SymbolBigFontSize">32</x:Double>
    <x:Double x:Key="AlphabetFontSize">16</x:Double>
    <x:Double x:Key="AlphabetBigFontSize">20</x:Double>
    <x:String x:Key="AlphabetFontFamily">Segoe UI</x:String>
    <x:String x:Key="SymbolFontFamily">Segoe MDL2 Assets</x:String>

    <x:Double x:Key="KeyboardSettingsAlphabetBigFontSizeRatio">0.112359551</x:Double>
    <x:Double x:Key="KeyboardSettingsAlphabetFontSizeRatio">0.0898876404</x:Double>
    <x:Double x:Key="KeyboardSettingsDescriptionWidthRate">0.943820225</x:Double>
    <x:Double x:Key="KeyboardSettingsFlyoutHeightRate">3.607142857142857</x:Double> <!-- 202px (KeyboardSettingsFlyout height) / 56px (base key height) -->
    <x:Double x:Key="KeyboardSettingsFlyoutHeightRate_Narrow">3.666666666666667</x:Double> <!-- 176px (KeyboardSettingsFlyout height) / 48px (base key height) -->
    <x:Double x:Key="KeyboardSettingsIconSizeRate">0.269662921</x:Double>
    <x:Double x:Key="KeyboardSettingsMenuKeyAutoResizeRate">0.416</x:Double>
    <x:Double x:Key="KeyboardSettingsMenuListViewItemWidthRate">0.303370787</x:Double>
    <x:Double x:Key="KeyboardSettingsMenuListViewItemHeightRate">0.303370787</x:Double>
    <x:Double x:Key="KeyboardSettingsPaddingLeftRate">0.02</x:Double>
    <x:Double x:Key="KeyboardSettingsPaddingTopRate">0.02</x:Double>
    <x:Double x:Key="KeyboardSettingsSettingsLauncherKeyWidthRate">1.3</x:Double>
    <x:Double x:Key="KeyboardSettingsBorderHeightRate">0.0049438195</x:Double>
    
    <x:Double x:Key="LanguageSwitcherListViewHeightRate">0.8125</x:Double>
    <x:Double x:Key="LanguageSwitcherListViewItemHeightRate">0.17140790739</x:Double>
    <x:Double x:Key="LanguageSwitcherPaddingRate">0.074074074</x:Double>
    <x:Double x:Key="LanguageSwitcherFlyoutWidthRate">4.571428571428571</x:Double> <!-- 320px (LanguageSwitcherFlyout width) / 70px (base key height) -->
    <x:Double x:Key="LanguageSwitcherFlyoutWidthRate_Narrow">6.956521739130435</x:Double> <!-- 320px (LanguageSwitcherFlyout width) / 46px (base key height) -->
    <x:Double x:Key="LanguageSwitcherFlyoutWidthRate_Handwriting">5.714285714285714</x:Double> <!-- 320px (LanguageSwitcherFlyout width) / 56px (base key height) -->
    <x:Double x:Key="LanguageSwitcherFlyoutWidthRate_HandwritingNarrow">4.210526315789474</x:Double> <!-- 320px (LanguageSwitcherFlyout width) / 76px (base key height) -->

    <Size x:Key="KeyboardSettingsMenuKeyDefaultSize">52.0,52.0</Size>

    <x:String x:Key="MarginSize">1</x:String>
    <x:String x:Key="StandardKeyboardGlyph">&#xE92E;</x:String>

    <Style x:Key="KeyboardSettingsBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WideNarrowFunctionalKeyBackgroundBrush}"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="1"/>
    </Style>

    <Style x:Key="LanguageSwitcherAutoResizeTextBlockStyle" TargetType="local:AutoResizeTextblock">
        <Setter Property="FontSizeRatio" Value="0.65"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="KeyboardSettingsMenuAutoResizeTextBlockStyle" TargetType="local:AutoResizeTextblock">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="KeyboardSettingsMenuButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Canvas x:Name="RootPanel" 
                          Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootPanel.Background" Value="{ThemeResource SystemControlHighlightListLowBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootPanel.Background" Value="{ThemeResource SystemControlHighlightListMediumBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <local:AutoResizeTextblock
                            x:Name="TEMPLATE_PART_Textblock"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Style="{StaticResource KeyboardSettingsMenuAutoResizeTextBlockStyle}"
                            FontSizeRatio="{StaticResource KeyboardSettingsMenuKeyAutoResizeRate}"
                            TextBlockStyle="{StaticResource SymbolKeyStyle}"
                            AutomationProperties.AccessibilityView="Raw"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KeyboardSettingsMenuButtonSelectedStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SystemAccentColor}" />
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Canvas x:Name="RootPanel" 
                          Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootPanel.Background" Value="{ThemeResource SystemAccentColor}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootPanel.Background" Value="{ThemeResource SystemAccentColor}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <local:AutoResizeTextblock
                            x:Name="TEMPLATE_PART_Textblock"
                            Foreground="{ThemeResource MenuSelectedItemForegroundBrush}"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            Style="{StaticResource KeyboardSettingsMenuAutoResizeTextBlockStyle}"
                            FontSizeRatio="{StaticResource KeyboardSettingsMenuKeyAutoResizeRate}"
                            TextBlockStyle="{StaticResource SymbolKeyStyle}"
                            AutomationProperties.AccessibilityView="Raw"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LanguageProfileButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Canvas x:Name="RootPanel"
                          Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootPanel.Background" Value="{ThemeResource SystemControlHighlightListLowBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootPanel.Background" Value="{ThemeResource SystemControlHighlightListMediumBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentControl
                            x:Name="TEMPLATE_PART_LanguageProfileControl"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.AccessibilityView="Raw"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LanguageProfileButtonSelectedStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SystemControlHighlightListAccentLowBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Canvas x:Name="RootPanel"
                          Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootPanel.Background" Value="{ThemeResource SystemControlHighlightListLowBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootPanel.Background" Value="{ThemeResource SystemControlHighlightListMediumBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentControl
                            x:Name="TEMPLATE_PART_LanguageProfileControl"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.AccessibilityView="Raw"/>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DescriptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource AlphabetFontFamily}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>

    <Style x:Key="TextBlockStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource AlphabetFontFamily}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="AbbreviationTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="SymbolTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource SymbolFontFamily}"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="KeyStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="{StaticResource MarginSize}"/>
        <Setter Property="FontFamily" Value="{StaticResource AlphabetFontFamily}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
        
    <Style x:Key="AbbreviationLanguageKeyStyle" TargetType="TextBlock" BasedOn="{StaticResource KeyStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SymbolKeyStyle" TargetType="TextBlock" BasedOn="{StaticResource KeyStyle}">
        <Setter Property="FontFamily" Value="{StaticResource SymbolFontFamily}"/>
    </Style>

    <DataTemplate x:Key="DefaultKeyContentTemplate"                                                >
        <ContentControl x:ConnectionId='28'
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <local:AutoResizeTextblock x:ConnectionId='29'                                            Style="{StaticResource LanguageSwitcherAutoResizeTextBlockStyle}" TextBlockStyle="{StaticResource AbbreviationLanguageKeyStyle}" />
        </ContentControl>
    </DataTemplate>

    <local:InputSwitcherIconTemplateSelector x:Key="LanguageKeyDataTemplateSelector"
                                            DefaultDataTemplate="{StaticResource DefaultKeyContentTemplate}" />

    <DataTemplate x:Key="DefaultDescriptionContentTemplate"                                                >
        <Grid x:ConnectionId='25' HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="17*"/>
                <RowDefinition Height="18*"/>
                <RowDefinition Height="17*"/>
            </Grid.RowDefinitions>
            <local:AutoResizeTextblock x:ConnectionId='26' Grid.Row="1" Style="{StaticResource LanguageSwitcherAutoResizeTextBlockStyle}" TextBlockStyle="{StaticResource DescriptionTextBlockStyle}"                                                />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TwoRowSymbolDescriptionContentTemplate"                                                >
        <Grid x:ConnectionId='21' HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.11392405064*"/>
                <RowDefinition Height="0.38607594936*"/>
                <RowDefinition Height="0.38607594936*"/>
                <RowDefinition Height="0.11392405064*"/>
            </Grid.RowDefinitions>
            <local:AutoResizeTextblock x:ConnectionId='22' Grid.Row="1" FontSizeRatio="0.7" Style="{StaticResource LanguageSwitcherAutoResizeTextBlockStyle}" TextBlockStyle="{StaticResource DescriptionTextBlockStyle}"                                                />
            <local:AutoResizeTextblock x:ConnectionId='23' Grid.Row="2" FontSizeRatio="0.7" Style="{StaticResource LanguageSwitcherAutoResizeTextBlockStyle}" TextBlockStyle="{StaticResource DescriptionTextBlockStyle}"                                                      />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LanguageProfileContentTemplate"                                                 >
        <Grid x:ConnectionId='17'
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
                                                                         
            AutomationProperties.AccessibilityView="Raw">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.0375*"></ColumnDefinition>
                <ColumnDefinition Width="0.15*"></ColumnDefinition>
                <ColumnDefinition Width="0.05*"></ColumnDefinition>
                <ColumnDefinition Width="0.6875*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <ContentControl x:ConnectionId='18'                                                             ContentTemplateSelector="{StaticResource LanguageKeyDataTemplateSelector}" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <ContentControl x:ConnectionId='19'                                                             ContentTemplateSelector="{StaticResource LanguageDescriptionDataTemplateSelector}" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </DataTemplate>

    <local:InputSwitcherDescriptionTemplateSelector x:Key="LanguageDescriptionDataTemplateSelector"
                                            DefaultDataTemplate="{StaticResource DefaultDescriptionContentTemplate}"
                                            TwoRowDataTemplate="{StaticResource TwoRowSymbolDescriptionContentTemplate}"/>

    <Style x:Key="SettingLauncherButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlHighlightListLowBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlHighlightListMediumBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <local:AutoResizeTextblock
                            x:Name="IconView"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            FontSizeRatio="{StaticResource KeyboardSettingsMenuKeyAutoResizeRate}"
                            AutomationProperties.AccessibilityView="Raw"
                            Style="{StaticResource LanguageSwitcherAutoResizeTextBlockStyle}"
                            TextBlockStyle="{StaticResource SymbolTextBlockStyle}"
                            Text="{TemplateBinding Content}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultButtonStyle" TargetType="Button">
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsTapEnabled" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{ThemeResource WideNarrowCandidateLabelBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="TEMPLATE_PART_ButtonRootBorder"
                        IsHitTestVisible="True"
                        Padding="{TemplateBinding Padding}"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="TEMPLATE_PART_ButtonRootBorder.Background" Value="{ThemeResource WideNarrowKeyboardBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="TEMPLATE_PART_ButtonRootBorder.Background" Value="{ThemeResource DefaultButtonPointerOverBackgroundColor}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="TEMPLATE_PART_ButtonRootBorder.Background" Value="{ThemeResource DefaultButtonPressedBackgroundColor}" />
                                        <Setter Target="TEMPLATE_PART_ButtonRootBorder.Foreground" Value="{ThemeResource DefaultButtonPressedForegroundColor}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <TextBlock x:Name="TEMPLATE_PART_ButtonContent"
                            Text="{TemplateBinding ButtonText}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            FontSize="{TemplateBinding FontSize}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <AcrylicBrush x:Key="MenuBackgroundAcrylicBrush" BackgroundSource="Backdrop" TintColor="#1F1F1F" FallbackColor="#444444" TintOpacity="0.8" />
            <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="MenuGridBorderBrush" Color="#ffffff" Opacity ="0.40" />
            <SolidColorBrush x:Key="MenuSelectedItemForegroundBrush" Color="#ffffff" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <AcrylicBrush x:Key="MenuBackgroundAcrylicBrush" BackgroundSource="Backdrop" TintColor="#ccf6f6f6" FallbackColor="{StaticResource SystemChromeMediumColor}" TintOpacity="0.8" />  <!-- SystemControlAcrylicElementBrush with grey tint color  -->
            <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource SystemChromeMediumColor}" />
            <SolidColorBrush x:Key="MenuGridBorderBrush" Color="Black" Opacity ="0.40" />
            <SolidColorBrush x:Key="MenuSelectedItemForegroundBrush" Color="{ThemeResource SystemAltHighColor}" />
        </ResourceDictionary>

        <!--
            This covers the High Contrast Theme as long as the standard High Contrast colors are used (ThemeResource SystemColor)
        -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="MenuBackgroundAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MenuGridBorderBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="MenuSelectedItemForegroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

