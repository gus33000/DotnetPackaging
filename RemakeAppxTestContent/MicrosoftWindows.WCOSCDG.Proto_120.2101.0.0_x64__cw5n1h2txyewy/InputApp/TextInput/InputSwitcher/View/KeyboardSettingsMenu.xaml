<UserControl x:ConnectionId='1'
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.KeyboardSettingsMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked"
    xmlns:controls="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls"
    xmlns:converter="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AutomationId="KeyboardSettingsFlyout"
    AutomationProperties.LocalizedControlType="pane"
                                                                                   
    >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/InputSwitcherStylesAndTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:ConnectionId='2' 
        x:Name="OverlayGrid"
        x:Load="False"                                                             
        BorderBrush="Transparent" 
        Background="Transparent" 
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top"
        AutomationProperties.LocalizedControlType="button"
                                         
                                           
                                     
                                           
                                                 
        >
        <StackPanel x:ConnectionId='3' x:Name="KeyboardSettingsMenuGrid"
                    BorderBrush="{ThemeResource MenuGridBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
            <StackPanel x:ConnectionId='4' x:Name="KeyboardSettingsModeStackPanel"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal"
                    AutomationProperties.AutomationId="KeyboardSettingsModeList"/>
            <Border x:ConnectionId='5' x:Name="KeyboardSettingsModeBorder"
                    x:Load="False"                                                           
                    Style="{StaticResource KeyboardSettingsBorderStyle}"/>
            <StackPanel x:ConnectionId='6' x:Name="KeyboardSettingsPositionStackPanel"
                    x:Load="False"                                                           
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal"
                    AutomationProperties.AutomationId="KeyboardSettingsPositionList"/>
            <Border x:ConnectionId='7' x:Name="KeyboardSettingsPositionBorder" 
                    x:Load="False"                                                           
                    Style="{StaticResource KeyboardSettingsBorderStyle}"/>
            <StackPanel x:ConnectionId='8' x:Name="SettingLauncherStackPanel"
                    x:Load="False"                                                           
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Orientation="Horizontal"
                    AutomationProperties.AutomationId="SettingLauncherList"
                                                  >
                <Button x:ConnectionId='9'
                    x:Name="LanguageSettingLauncher"
                    Style="{StaticResource SettingLauncherButtonStyle}"
                                                          />
                <Button x:ConnectionId='10'
                    x:Name="TypingOrPenSettingLauncher"
                    Style="{StaticResource SettingLauncherButtonStyle}"
                                                             />
                <Button x:ConnectionId='11'
                    x:Name="TipsLauncher"
                    x:Load="False"                                                       
                    Style="{StaticResource SettingLauncherButtonStyle}"
                                               />
                <Button x:ConnectionId='12'
                    x:Name="ComposeModeSwitcher"
                    Style="{StaticResource SettingLauncherButtonStyle}"
                                                      
                    Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

