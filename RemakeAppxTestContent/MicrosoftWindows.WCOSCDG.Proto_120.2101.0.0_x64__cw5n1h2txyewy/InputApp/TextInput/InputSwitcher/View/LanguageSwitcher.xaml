<UserControl x:ConnectionId='1'
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.LanguageSwitcher"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked"
    xmlns:converter="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Converter"
    xmlns:common="using:WindowsInternal.ComposableShell.Experiences.TextInput.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.LocalizedControlType="pane"
    >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/InputSwitcherStylesAndTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:ConnectionId='2'
        x:Name="OverlayGrid"
                                                                                   
        BorderBrush="Transparent" 
        Background="Transparent" 
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AutomationProperties.LocalizedControlType="button"
                                         
                                           
                                     
                                           
                                                 
        >
        <ScrollViewer x:ConnectionId='3'
            x:Name="LanguageSwitcherScrollViewer"
            BorderBrush="{ThemeResource MenuGridBorderBrush}"
                                                                             
            BorderThickness="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:ConnectionId='5' x:Name="LanguageSwitcherStackPanel"
                    Orientation="Vertical"/>
        </ScrollViewer>
        <common:InputSwitcher x:ConnectionId='4'
            x:Name="ModernInputSwitcher"
                                                                              />
    </Grid>
</UserControl>


