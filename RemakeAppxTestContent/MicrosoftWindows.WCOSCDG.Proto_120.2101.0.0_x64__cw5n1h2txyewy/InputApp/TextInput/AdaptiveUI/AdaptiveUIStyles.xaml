        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="TabNavigation" Value="Local"/>
        <Setter Property="IsHoldingEnabled" Value="True"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinWidth" Value="{ThemeResource ListViewItemMinWidth}"/>
        <Setter Property="MinHeight" Value="{ThemeResource ListViewItemMinHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                  ContentTransitions="{TemplateBinding ContentTransitions}"
                  SelectionCheckMarkVisualEnabled="True"
                  CheckBrush="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"
                  CheckBoxBrush="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"
                  DragBackground="{ThemeResource ListViewItemDragBackgroundThemeBrush}"
                  DragForeground="{ThemeResource ListViewItemDragForegroundThemeBrush}"
                  FocusBorderBrush="{ThemeResource SystemControlForegroundAltHighBrush}"
                  FocusSecondaryBorderBrush="{ThemeResource SystemControlForegroundBaseHighBrush}"
                  PlaceholderBackground="{ThemeResource ListViewItemPlaceholderBackgroundThemeBrush}"
                  PointerOverBackground="{ThemeResource SystemControlHighlightListLowBrush}"
                  PointerOverForeground="{ThemeResource SystemControlHighlightAltBaseHighBrush}"
                  SelectedBackground="{ThemeResource SystemControlHighlightListAccentLowBrush}"
                  SelectedForeground="{ThemeResource SystemControlHighlightAltBaseHighBrush}"
                  SelectedPointerOverBackground="{ThemeResource SystemControlHighlightListAccentMediumBrush}"
                  PressedBackground="{ThemeResource SystemControlHighlightListMediumBrush}"
                  SelectedPressedBackground="{ThemeResource SystemControlHighlightListAccentHighBrush}"
                  DisabledOpacity="{ThemeResource ListViewItemDisabledThemeOpacity}"
                  DragOpacity="{ThemeResource ListViewItemDragThemeOpacity}"
                  ReorderHintOffset="{ThemeResource ListViewItemReorderHintThemeOffset}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  ContentMargin="{TemplateBinding Padding}"
                  CheckMode="Inline"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AdaptiveSuggestionListItemContainerStyle" TargetType="ListViewItem">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource WideNarrowCandidateLabelBrush}" />
        <Setter Property="TabNavigation" Value="Local"/>
        <Setter Property="IsHoldingEnabled" Value="False"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <!-- template for listviewitem is based on https://msdn.microsoft.com/en-us/library/windows/apps/mt299136.aspx then stripped of unnecessary stuff like dragging/multiselect etc + some UI tree/VSM/style modifications -->
            <ControlTemplate TargetType="ListViewItem">
              <Grid>
                <!--
                    this custom VSM is needed to support custom selection logic; it won't be used if list doesn't implement custom selection logic (see SelectableListView)
                    still, it should be present here since some SIP keyboards require candidate selection, and we don't want to increase amount of listviewitem templates too much;
                -->
                <VisualStateManager.CustomVisualStateManager>
                  <controls:CustomSelectableItemVisualStateManager />
                </VisualStateManager.CustomVisualStateManager>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                      <Storyboard>
                        <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="BorderBackground"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0"
                                          To="1"/>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderBackground" Storyboard.TargetProperty="Fill">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateItemPanelPointerOverBackgroundBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateStringPointerOverForegroundBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="BorderBackground"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0"
                                          To="1"/>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderBackground" Storyboard.TargetProperty="Fill">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateItemPanelSelectedItemBackgroundBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateItemPanelSelectedItemForegroundBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <PointerDownThemeAnimation TargetName="ContentPresenter" />
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Selected">
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="BorderBackground"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0"
                                          To="1"/>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderBackground" Storyboard.TargetProperty="Fill">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateItemPanelSelectedItemBackgroundBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateItemPanelSelectedItemForegroundBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                  <!--
                      these are states for custom selection/deselection for hardware key navigation support; need to live in their own VSM group so there's no interference between them "CommonStates" group states;
                      whether these are actually used or not depends on actual type of the list (see SelectableListView);
                      still, these states should be present here since some SIP keyboards require candidate selection, and we don't want to increase amount of listviewitem templates too much;
                      if the list supports usual selection (ListViewSelectionMode), as in the case with pinyin/stroke filter, it will use CommonStates.Selected state
                  -->
                  <VisualStateGroup x:Name="CustomSelectionStates">
                    <VisualState x:Name="CustomSelectionOff">
                      <Storyboard>
                        <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="CustomSelectionOn">
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="BorderBackground"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0"
                                          To="1"/>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderBackground" Storyboard.TargetProperty="Fill">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateItemPanelSelectedItemBackgroundBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateItemPanelSelectedItemForegroundBrush}" />
                        </ObjectAnimationUsingKeyFrames>
                        <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Rectangle x:Name="BorderBackground"
                          IsHitTestVisible="False"
                          Opacity="0"
                          Control.IsTemplateFocusTarget="True"/>

                <Grid x:Name="ContentPresenterGrid"
                      Background="Transparent"
                      Margin="0,0,0,0">
                  <ContentPresenter x:Name="ContentPresenter"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Content="{TemplateBinding Content}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"/>
                </Grid>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="AdaptiveSuggestionHorizontalListItemContainerStyle" BasedOn="{StaticResource AdaptiveSuggestionListItemContainerStyle}" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,0"/>  <!-- this value is a default and might be overridden in runtime, for instance, in case of AdaptiveListViewItem -->
      </Style>

      <Style x:Key="AdaptiveSuggestionVerticalListItemContainerStyle" BasedOn="{StaticResource AdaptiveSuggestionListItemContainerStyle}" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="5"/>  <!-- this value is a default and might be overridden in runtime, for instance, in case of AdaptiveListViewItem -->
      </Style>

      <Style x:Key="AdaptiveSuggestionFilterVerticalListItemContainerStyle" BasedOn="{StaticResource AdaptiveSuggestionListItemContainerStyle}" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="5"/> <!-- this value is a default and might be overridden in runtime, for instance, in case of AdaptiveListViewItem -->
      </Style>

      <Style x:Key="AdaptiveSuggestionExpandedListItemContainerStyle" BasedOn="{StaticResource AdaptiveSuggestionListItemContainerStyle}" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <!-- TODO: this should be sorted out somehow:
                    because of * sizing of the first Grid row (which is collapsed candidate window), the height of it is dynamic;
                    on the other hand, the height of the list view row needs to be setup explicitly (or it will be as high as the highest list view item content in that row;
                    current empirical value is AdaptiveControlHeight = 44px, but since it is static it won't be stretched when the whole keyboard is resized
        -->
        <Setter Property="MinHeight" Value="{StaticResource AdaptiveControlHeight}"/>
        <Setter Property="Padding" Value="10,0"/> <!-- this value is a default and might be overridden in runtime, for instance, in case of AdaptiveListViewItem -->
      </Style>

      <Style x:Key="AdaptiveSuggestionScaledExpandedListItemContainerStyle" BasedOn="{StaticResource AdaptiveSuggestionExpandedListItemContainerStyle}" TargetType="controls:AdaptiveListViewItem">
        <Setter Property="FontSizeOverrideMode" Value="UseParentListHeight" />
      </Style>

      <Style x:Key="UnscrollableListItemContainerStyle" BasedOn="{StaticResource AdaptiveSuggestionListItemContainerStyle}" TargetType="ListViewItem">
        <Setter Property="Padding" Value="2"/>
      </Style>

    <!-- Note: The only candidate windows that use this would mainly be JP and CHS as they require additional UI elements in the item itself, Latin just
           uses the SIP style without additional markup.-->
      <!-- this one (and its descendants) include not just a container for the item itself, but keyboard shortcut and possible other elements as well -->
      <Style x:Key="AdaptiveSuggestionListItemContainerHardwareKeyboardStyle" BasedOn="{StaticResource AdaptiveSuggestionListItemContainerStyle}" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{ThemeResource HardwareKeyboardCandidateLabelBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
          <Setter.Value>
            <!-- template for listviewitem is based on https://msdn.microsoft.com/en-us/library/windows/apps/mt299136.aspx then stripped of unnecessary stuff like dragging/multiselect etc + some UI tree/VSM/style modifications -->
            <ControlTemplate TargetType="ListViewItem">
              <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <!--
                    this custom VSM is needed to support custom selection logic; it won't be used if list doesn't implement custom selection logic (see SelectableListView), however any hardware candidate window should
                -->
                <VisualStateManager.CustomVisualStateManager>
                  <controls:CustomSelectableItemVisualStateManager />
                </VisualStateManager.CustomVisualStateManager>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <Storyboard>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DeleteItemButton" Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SearchItemButton" Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                </ObjectAnimationUsingKeyFrames>
                                <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="BorderBackground"
                                    Storyboard.TargetProperty="Opacity"
                                    Duration="0"
                                    To="1"/>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderBackground" Storyboard.TargetProperty="Fill">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightListLowBrush}" />
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DeleteItemButton" Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightListLowBrush}" />
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SearchItemButton" Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightListLowBrush}" />
                                </ObjectAnimationUsingKeyFrames>
                                <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="BorderBackground"
                                    Storyboard.TargetProperty="Opacity"
                                    Duration="0"
                                    To="1"/>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderBackground" Storyboard.TargetProperty="Fill">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightListAccentMediumBrush}" />
                                </ObjectAnimationUsingKeyFrames>
                                <PointerDownThemeAnimation TargetName="ContentPresenter" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                    <!-- these are states for custom selection/deselection for hardware key navigation support; need to live in their own VSM group so there's no interference between them "CommonStates" group states -->
                    <VisualStateGroup x:Name="CustomSelectionStates">
                        <VisualState x:Name="CustomSelectionOff">
                            <Storyboard>
                                <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="CustomSelectionOn">
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="BorderBackground"
                                    Storyboard.TargetProperty="Opacity"
                                    Duration="0"
                                    To="1"/>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BorderBackground" Storyboard.TargetProperty="Fill">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightListAccentLowBrush}" />
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DeleteItemButton" Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightListAccentLowBrush}" />
                                </ObjectAnimationUsingKeyFrames>
                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SearchItemButton" Storyboard.TargetProperty="Background">
                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SystemControlHighlightListAccentLowBrush}" />
                                </ObjectAnimationUsingKeyFrames>
                                <PointerUpThemeAnimation Storyboard.TargetName="ContentPresenter" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Rectangle x:Name="BorderBackground" IsHitTestVisible="False" Opacity="0" Control.IsTemplateFocusTarget="True"/>
                <Grid x:Name="ContentPresenterGrid"
                        Padding="0"
                        Margin="12,0,6,0"
                        Background="{TemplateBinding Background}"
                        MinHeight="{TemplateBinding MinHeight}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition MinWidth="20" Width="*"/>
                        <ColumnDefinition MinWidth="32" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- KeyboardShortcutText.FontSize is a default value and might be overridden in runtime, for instance, in case of AdaptiveListViewItem -->
                    <!-- KeyboardShortcutTextContainer.Margin is a default value and might be overridden in runtime, for instance, in case of AdaptiveListViewItem -->
                    <!-- setting MinWidth to some reasonable value (width of one digit number) so UI is not jumping when shortcuts are assigned -->
                    <!-- move to style if necessary for reuse -->
                    <!-- the value for shortcut text (and also the visibility of the shortcut UI element) is assigned dynamically -->
                    <Border Margin="0,0,12,0" Padding="0,5,0,7" Grid.Column="0" x:Name="KeyboardShortcutTextContainer" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <TextBlock x:Name="KeyboardShortcutText" MinWidth="10" Style="{StaticResource BodyTextBlockStyle}"/>
                    </Border>
                    <ContentPresenter x:Name="ContentPresenter"
                        Grid.Column="1"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Content="{TemplateBinding Content}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Padding="0,5,0,7"/>
                      <controls:SimpleButton x:Name="DeleteItemButton"
                          ButtonText="&#xE711;"
                          Grid.Column="3"
                          Style="{StaticResource CandidateActionButtonStyle}">
                          <ToolTipService.ToolTip>
                            <ToolTip x:Name="DeleteItemToolTip" Placement="Mouse"/>
                          </ToolTipService.ToolTip>
                      </controls:SimpleButton>

                      <controls:SimpleButton x:Name="SearchItemButton"
                          ButtonText="&#xE721;"
                          Grid.Column="4"
                          Style="{StaticResource CandidateActionButtonStyle}">
                          <ToolTipService.ToolTip>
                            <ToolTip x:Name="SearchItemToolTip" Placement="Mouse"/>
                          </ToolTipService.ToolTip>
                      </controls:SimpleButton>
                  <!-- comment button doesn't have visual states by design. -->
                  <controls:SimpleButton x:Name="ItemCommentButton"
                              ButtonText="&#xE82D;"
                              Grid.Column="3"
                              Width="32"
                              Style="{StaticResource CandidateActionButtonStyle}"
                              HorizontalAlignment="Right"
                              Visibility="Collapsed" />
                </Grid>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

