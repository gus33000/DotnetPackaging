                                           Background="{ThemeResource HardwareKeyboardCandidateListFooterBackgroundColor}"
                                           Style="{TemplateBinding ExpandButtonStyle}"/>
                  </Grid>

                  <Grid x:Name="TEMPLATE_PART_AdaptiveExpandedContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Prediction candidate window, expanded (more candidates) -->
                    <controls:SelectableListView x:Name="TEMPLATE_PART_AdaptiveExpandedView"
                                                 Grid.Row="0"
                                                 ResizeListMode="Uniform"
                                                 IsStaticallyPaged="True"
                                                 StaticPagingItemsPerPage="9"
                                                 ItemsInView="9"
                                                 WrapSelection="True"
                                                 AllowPaddingForLastPage="True"
                                                 KeyboardShortcutAssignmentMode="{TemplateBinding KeyboardShortcutAssignmentMode}"
                                                 Background="{TemplateBinding Background}"
                                                 Style="{TemplateBinding SuggestionListStyle}"
                                                 AutomationProperties.AutomationId="IME_Candidate_Window">
                    </controls:SelectableListView>
                    <controls:SimpleButton x:Name="TEMPLATE_PART_ExpandedViewFooter"
                                           Grid.Row="1"
                                           Visibility="Collapsed"
                                           HorizontalContentAlignment="Left"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           Background="{ThemeResource HardwareKeyboardCandidateListFooterBackgroundColor}"
                                           Style="{TemplateBinding ExpandButtonStyle}"/>
                  </Grid>

                  <!-- Conversion candidate window, unexpanded (single column) -->
                  <!-- ItemsInView here and MaximumRowsOrColumns for ItemsPanel of TEMPLATE_PART_AdaptiveExpandedView should be the same value (=9)-->
                  <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:SelectableListView x:Name="TEMPLATE_PART_AdaptiveConversionSuggestionList"
                                                 Grid.Row="0"
                                                 Visibility="Collapsed"
                                                 Background="{TemplateBinding Background}"
                                                 ResizeListMode="Uniform"
                                                 ItemsInView="9"
                                                 IsStaticallyPaged="True"
                                                 StaticPagingItemsPerPage="9"
                                                 WrapSelection="True"
                                                 AllowPaddingForLastPage="True"
                                                 KeyboardShortcutAssignmentMode="{TemplateBinding KeyboardShortcutAssignmentMode}"
                                                 MinWidth="176"
                                                 Style="{TemplateBinding SuggestionListStyle}"
                                                 AutomationProperties.AutomationId="IME_Candidate_Window">
                     </controls:SelectableListView>
                     <controls:SimpleButton x:Name="TEMPLATE_PART_ConversionExpandButton"
                                            Grid.Row="1"
                                            Visibility="Collapsed"
                                            Background="{ThemeResource HardwareKeyboardCandidateListFooterBackgroundColor}"
                                            HorizontalContentAlignment="Right"
                                            ButtonText="&#xEA5B;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Padding="0,0,4,0"
                                            Style="{TemplateBinding ExpandButtonStyle}"/>
                  </Grid>

                  <!-- Conversion candidate window, expanded (multicolumns) -->
                  <!-- TODO: value for ItemsInView most probably depends on current screen resolution -->
                  <!-- don't define a style  for this list, since it won't be reusable as of now; move to style if necessary later-->
                  <Grid x:Name="TEMPLATE_PART_AdaptiveConversionExpandedContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:SelectableListView x:Name="TEMPLATE_PART_AdaptiveConversionExpandedView"
                                                 Grid.Row="0"
                                                 ResizeListMode="Uniform"
                                                 ItemsInView="4"
                                                 IsTableView="True"
                                                 TableViewItemsPerColumn="9"
                                                 WrapSelection="True"
                                                 Background="{TemplateBinding Background}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                 ScrollViewer.HorizontalScrollMode="Auto"
                                                 ScrollViewer.VerticalScrollMode="Disabled"
                                                 ScrollViewer.IsVerticalScrollChainingEnabled="False"
                                                 ItemContainerStyle="{TemplateBinding ExpandedItemContainerStyle}"
                                                 KeyboardShortcutAssignmentMode="SelectedArea"
                                                 ItemTemplateSelector="{StaticResource TableViewAdaptiveItemDataTemplateSelector}"
                                                 Style="{TemplateBinding ExpandedListStyle}"
                                                 IsStaticallyPaged="{TemplateBinding IsTableViewStaticallyPaged}"
                                                 StaticPagingItemsPerPage="{TemplateBinding TableViewStaticPagingItemsPerPage}"
                                                 AutomationProperties.AutomationId="ExpandedCandidateList">
                      <controls:SelectableListView.ItemsPanel>
                        <ItemsPanelTemplate>
                          <ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="9" ItemWidth="{StaticResource TableViewDefaultItemWidth}"/>
                        </ItemsPanelTemplate>
                      </controls:SelectableListView.ItemsPanel>
                      <!-- override default ListView template to make list scrolling snap horizontally -->
                      <controls:SelectableListView.Template>
                        <ControlTemplate TargetType="ListView">
                          <Border BorderBrush="{TemplateBinding BorderBrush}"
                                  Background="{TemplateBinding Background}"
                                  BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="ScrollViewer"
                                          HorizontalSnapPointsAlignment="Near"
                                          HorizontalSnapPointsType="Mandatory"
                                          TabNavigation="{TemplateBinding TabNavigation}"
                                          HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                          HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                          IsHorizontalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsHorizontalScrollChainingEnabled}"
                                          VerticalScrollMode="{TemplateBinding ScrollViewer.VerticalScrollMode}"
                                          VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                          IsVerticalScrollChainingEnabled="{TemplateBinding ScrollViewer.IsVerticalScrollChainingEnabled}"
                                          IsHorizontalRailEnabled="{TemplateBinding ScrollViewer.IsHorizontalRailEnabled}"
                                          IsVerticalRailEnabled="{TemplateBinding ScrollViewer.IsVerticalRailEnabled}"
                                          ZoomMode="{TemplateBinding ScrollViewer.ZoomMode}"
                                          IsDeferredScrollingEnabled="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                                          BringIntoViewOnFocusChange="{TemplateBinding ScrollViewer.BringIntoViewOnFocusChange}"
                                          AutomationProperties.AccessibilityView="Raw">
                              <ItemsPresenter
                                  Header="{TemplateBinding Header}"
                                  HeaderTransitions="{TemplateBinding HeaderTransitions}"
                                  Footer="{TemplateBinding Footer}"
                                  FooterTemplate="{TemplateBinding FooterTemplate}"
                                  FooterTransitions="{TemplateBinding FooterTransitions}"
                                  Padding="{TemplateBinding Padding}"/>
                            </ScrollViewer>
                          </Border>
                        </ControlTemplate>
                      </controls:SelectableListView.Template>
                    </controls:SelectableListView>
                    <controls:SimpleButton x:Name="TEMPLATE_PART_ConversionCollapseButton"
                                           Grid.Row="1"
                                           Background="{ThemeResource HardwareKeyboardCandidateListFooterBackgroundColor}"
                                           HorizontalContentAlignment="Right"
                                           ButtonText="&#xEA49;"
                                           Visibility="Collapsed"
                                           FontFamily="Segoe MDL2 Assets"
                                           Padding="0,0,4,0"
                                           Style="{TemplateBinding ExpandButtonStyle}"/>
                  </Grid>
                </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

