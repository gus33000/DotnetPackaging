                            <RowDefinition Height="{StaticResource KeyboardCandidateBarHeight}" />
                            <RowDefinition Height="{StaticResource KeyboardGridHeight}" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0">
                            <Grid x:Name="TEMPLATE_PART_AdaptiveControlCandidateBar">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="8"
                                      x:Name="TEMPLATE_PART_Gripper"
                                      Background="{TemplateBinding Background}"
                                      Visibility="Collapsed"
                                      AutomationProperties.AutomationId="MoveGripper"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

                                <controls:KeyboardSettingsMenuKey
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      x:Name="TEMPLATE_PART_KeyboardSettingsMenuKey"
                                      Style="{StaticResource KeyboardSettingsMenuKeyStyle}" />

                                <controls:DictationMicrophoneButton
                                      Grid.Row="0"
                                      Grid.Column="2"
                                      x:Name="TEMPLATE_PART_DictationMicrophoneButton"
                                      Background="{TemplateBinding Background}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Visibility="Collapsed"
                                      Style="{StaticResource DictationMicrophoneButtonStyle}" />

                                <controls:SimpleButton
                                      Grid.Row="0"
                                      Grid.Column="3"
                                      x:Name="TEMPLATE_PART_CopyButton"
                                      Style="{StaticResource ContextualButtonStyle}"
                                      Visibility="Collapsed"
                                      ButtonText="&#xE8C8;"
                                      AutomationProperties.AutomationId="CopyButton"/>

                                <controls:PasteControl
                                      Grid.Row="0"
                                      Grid.Column="4"
                                      x:Name="TEMPLATE_PART_PasteControl"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Style="{StaticResource PasteControlStyle}"/>

                                <!-- TODO: temp button for showing clipboard UI from SIP; visibility is controlled by velocity key -->
                                <controls:SimpleButton
                                      Grid.Row="0"
                                      Grid.Column="4"
                                      x:Name="TEMPLATE_PART_ShowClipboardControlButton"
                                      Style="{StaticResource ContextualButtonStyle}"
                                      Visibility="Collapsed"
                                      ButtonText="&#xE77F;"
                                      AutomationProperties.AutomationId="ShowClipboardButton"/>

                                <controls:DictationStateErrorControl
                                      Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="9"
                                      x:Name="TEMPLATE_PART_DictationStateErrorControl"
                                      Background="{TemplateBinding Background}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      Style="{StaticResource DictationStateErrorControlStyle}" />

                                <controls:DictationHintControl
                                      Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="9"
                                      x:Name="TEMPLATE_PART_DictationHintControl"
                                      Background="{TemplateBinding Background}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"
                                      Style="{StaticResource DictationHintControlStyle}" />

                                <controls:SelectableListView
                                      Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="9"
                                      x:Name="TEMPLATE_PART_AdaptiveSuggestionList"
                                      Background="{TemplateBinding Background}"
                                      Style="{TemplateBinding SuggestionListStyle}"
                                      AutomationProperties.AutomationId="IME_Candidate_Window">
                                </controls:SelectableListView>

                                <Border
                                      Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="9"
                                      IsHitTestVisible="false"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <TextBlock x:Name="TEMPLATE_PART_StatusMessage" Style="{StaticResource AdaptiveControlStatusMessageStyle}"/>
                                </Border>

                                <controls:DictationSwitchButton
                                      Grid.Row="0"
                                      Grid.Column="7"
                                      x:Name="TEMPLATE_PART_DictationSwitchButton"
                                      Background="{TemplateBinding Background}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Visibility="Collapsed"
                                      Style="{StaticResource DictationSwitchButtonStyle}" />

                                <controls:SimpleButton
                                      Grid.Row="0"
                                      Grid.Column="8"
                                      x:Name="TEMPLATE_PART_CloseButton"
                                      Style="{StaticResource CloseButtonStyle}"
                                      AutomationProperties.AutomationId="CloseButton"/>
                            </Grid>
                        </Border>
                        <!-- TODO: add to other adaptive control styles -->
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Used by Wide/Narrow/Split Mode -->
