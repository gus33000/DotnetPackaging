    <!--https://microsoft.sharepoint.com/teams/wdg_ptp_shell/ae/Shared%20Documents/Projects/ML4TextInput/CHS%20CW%20refactoring.docx?web=1-->
    <!--The candidate panel has four parts:
        1) CandidateItemsPanel: Holds all the candidates. Aligned to the left
        2) BlankFill: To fill the possible gap between candidate items panel and quick action panel
        4) QuickActionPanel: buttons for quick actions. Aligned to the right
        3) ExtendedPanel: To the bottom of the candidate items panel for tools like tips windows
    -->
    <Style x:Key="HorizontalCandidateWindowStyle" TargetType="controls:HorizontalCandidatePanel">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:HorizontalCandidatePanel">
                    <Grid Background="{ThemeResource HorizontalCandidatePanelBackgroundAcrylicBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:HorizontalCandidateItemsPanel x:Name="TEMPLATE_PART_CandidateItemsPanel"  Grid.Column="0" Grid.Row="0" 
                                                                HorizontalAlignment="Left" CandidateItemStyle="{StaticResource CHSCandidateItemStyle}"/>
                        <Border x:Name="TEMPLATE_PART_BlankFill" Grid.Column="1" Grid.Row="0"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                BorderBrush="{StaticResource HorizontalCandidatePanelBorderBrush}" BorderThickness="0, 1, 0, 1"/>
                        <controls:HorizontalQuickActionPanel x:Name="TEMPLATE_PART_QuickActionPanel" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Right" Style="{StaticResource HorizontalQuickActionPanelStyle}"/>
                        <controls:ExtendedPanel x:Name="TEMPLATE_PART_ExtendedPanel" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed"/>
                        <Popup x:Name="TEMPLATE_PART_ContextMenuPop" AutomationProperties.AutomationId="ContextMenu" IsOpen="False" ShouldConstrainToRootBounds="False"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                Margin="0">
                            <StackPanel x:Name="TEMPLATE_PART_ContextMenu"
                                        BorderBrush="{ThemeResource HardwareKeyboardCandidateWindowBorderColor}"
                                        Background="{ThemeResource CandidatePanelBackgroundAcrylicBrush}"
                                        BorderThickness="0.5"
                                        CornerRadius="4"
                                        Margin="-1"/>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

