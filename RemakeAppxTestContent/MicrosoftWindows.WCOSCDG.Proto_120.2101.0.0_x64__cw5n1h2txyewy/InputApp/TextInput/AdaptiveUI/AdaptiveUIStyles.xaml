<ResourceDictionary
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls.AdaptiveUIStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:textinput="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked"
    xmlns:controls="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls"
    xmlns:layoutdata="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.LayoutData"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
      <!-- TODO: using DefaultCandidateItemHeightInRelativePixelsForHardwareKeyboard as height value; in reality might be more complicated, need to investigate -->
      <x:Double x:Key="AdaptiveControlHeight">44</x:Double>
      <x:Double x:Key="DefaultPagedViewMinHeight">36.67</x:Double>
      <x:Double x:Key="CandidateItemDefaultFontSize">15</x:Double> <!-- default value which must be the same as Utility\CandidateUIConstants.h:CandidateItemDefaultFontSize-->
      <x:Double x:Key="CandidateItemDefaultMetadataFontSize">12</x:Double> <!-- default value which must be the same as Utility\CandidateUIConstants.h:CandidateItemDefaultFontSize + CandidateItemMetadataFontSizeChange-->
      <x:Double x:Key="CandidateItemDefaultShortcutFontSize">12</x:Double> <!-- default value which must be the same as Utility\CandidateUIConstants.h:CandidateItemDefaultFontSize + CandidateItemKeyboardShorcutFontSizeChange-->
      <x:Double x:Key="TableViewDefaultItemWidth">106</x:Double>

      <SolidColorBrush x:Key="AdaptiveListViewItemSearchIconNormalForegroundColor" Color="DarkGray"/>
      <SolidColorBrush x:Key="AdaptiveListViewItemSearchIconHighlightForegroundColor" Color="Black"/>

      <x:String x:Key="FontFamilyECMDL2">ms-resource:///Files/InputApp/Assets/Fonts/ECMDL2.ttf#EC MDL2 Assets,/Assets/Fonts/ECMDL2.ttf#EC MDL2 Assets</x:String>

      <controls:CandidateItemToStringValueConverter x:Key="CandidateItemToStringValueConverter"/>
      <controls:StringValueToVisibilityConverter x:Key="StringValueToVisibilityConverter"/>

    <Style TargetType="controls:DirectWriteTextBlock">
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="FontSize" Value="{StaticResource CandidateItemDefaultFontSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DirectWriteTextBlock">
                    <Border x:Name="TextBackground" Background="{TemplateBinding Background}">
                    <!-- Don't change margin here. Margin should be reflected in the DirectWriteTextBlock class -->
                        <Image x:Name="Image" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- *********************************** styles and control templates for adaptive suggestion control *********************************** -->
      <Style x:Key="InputPanelAdaptiveControlBaseStyle" TargetType="controls:AdaptiveControl">
        <Setter Property="Background" Value="{ThemeResource WideNarrowCandidatePanelBackgroundBrush}" />
        <Setter Property="SuggestionListStyle" Value="{StaticResource DynamicPageFixInputPanelAdaptiveSuggestionListHorizontalStyle}" />
        <Setter Property="ExpandedListStyle" Value="{StaticResource InputPanelAdaptiveSuggestionExpandedListHorizontalStyle}" />
        <Setter Property="ExpandButtonStyle" Value="{StaticResource DefaultSimpleButtonStyle}" />
      </Style>

      <!-- Try to keep your child controls in one level of grid. This is because nesting grids/panels not only has an associated
      memory and layout cost, but also because XAML may have issues laying out the control. -->
      <!-- Used by Handwriting Mode -->
      <Style x:Key="InputPanel2RowAdaptiveControlHorizontalStyle" TargetType="controls:AdaptiveControl" BasedOn="{StaticResource InputPanelAdaptiveControlBaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:AdaptiveControl">
                    <Grid x:Name="TEMPLATE_PART_AdaptiveControlRoot">
                        <Grid.RowDefinitions>
                            <!-- actual values for the rows where these are used are adjusted based on InputPanel values, see AdaptiveControl.cpp:UpdateBasedOnInputPanelProperties -->
                            <RowDefinition Height="{StaticResource KeyboardCandidateBarHeight}" />
                            <RowDefinition Height="{StaticResource KeyboardGridHeight}" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0">
                            <Grid x:Name="TEMPLATE_PART_AdaptiveControlCandidateBar">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Grid.ColumnSpan="7"
                                        x:Name="TEMPLATE_PART_Gripper"
                                        Background="{TemplateBinding Background}"
                                        Visibility="Collapsed"
                                        AutomationProperties.AutomationId="MoveGripper"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>

                                <controls:KeyboardSettingsMenuKey
                                    Grid.Column="0"
                                    x:Name="TEMPLATE_PART_KeyboardSettingsMenuKey"
                                    Style="{StaticResource KeyboardSettingsMenuKeyStyle}" />

                                <controls:DictationMicrophoneButton
                                    Grid.Column="1"
                                    x:Name="TEMPLATE_PART_DictationMicrophoneButton"
                                    Background="{TemplateBinding Background}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Visibility="Collapsed"
                                    Style="{StaticResource DictationMicrophoneButtonStyle}" />

                                <controls:SimpleButton
                                    Grid.Column="2"
                                    x:Name="TEMPLATE_PART_CopyButton"
                                    Style="{StaticResource ContextualButtonStyle}"
                                    Visibility="Collapsed"
                                    ButtonText="&#xE8C8;"
                                    AutomationProperties.AutomationId="CopyButton"/>

                                <controls:PasteControl
                                    Grid.Column="3"
                                    x:Name="TEMPLATE_PART_PasteControl"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Style="{StaticResource PasteControlStyle}"/>

                                <controls:DictationStateErrorControl
                                    Grid.Column="4"
                                    x:Name="TEMPLATE_PART_DictationStateErrorControl"
                                    Background="{TemplateBinding Background}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Style="{StaticResource DictationStateErrorControlStyle}" />

                                <controls:DictationHintControl
                                    Grid.Column="4"
                                    x:Name="TEMPLATE_PART_DictationHintControl"
                                    Background="{TemplateBinding Background}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Style="{StaticResource DictationHintControlStyle}" />

                                <controls:SelectableListView
                                    Grid.Column="4"
                                    x:Name="TEMPLATE_PART_AdaptiveSuggestionList"
                                    Background="{TemplateBinding Background}"
                                    Style="{TemplateBinding SuggestionListStyle}">
                                </controls:SelectableListView>

                                <controls:DictationSwitchButton
                                    Grid.Column="5"
                                    x:Name="TEMPLATE_PART_DictationSwitchButton"
                                    Background="{TemplateBinding Background}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Visibility="Collapsed"
                                    Style="{StaticResource DictationSwitchButtonStyle}" />

                                <controls:SimpleButton
                                    Grid.Column="6"
                                    x:Name="TEMPLATE_PART_CloseButton"
                                    Style="{StaticResource CloseButtonStyle}"
                                    AutomationProperties.AutomationId="CloseButton"/>

                                <controls:HandwritingTipControl
                                    x:Name="TEMPLATE_PART_HandwritingTipControl"
                                    Grid.Column="4"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource HandwritingTipControlStyle}"
                                    Visibility="Collapsed"
                                    AutomationProperties.AutomationId="HandwritingTip"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
      </Style>

    <!-- 2 row Narrow Mode -->
    <Style x:Key="InputPanelAdaptiveControlTwoRowHorizontalSelectableStyle" TargetType="controls:AdaptiveControl" BasedOn="{StaticResource InputPanelAdaptiveControlBaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
