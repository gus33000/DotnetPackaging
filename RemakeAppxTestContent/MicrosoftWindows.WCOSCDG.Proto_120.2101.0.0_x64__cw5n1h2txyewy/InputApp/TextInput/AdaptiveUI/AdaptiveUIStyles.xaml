    <!--
          this is a very specific template for JPN and CHT HWKB UI (including expanded view); most probably, you don't want to use it for anything else:
              * Prediction List:
                - 5 items visible
                - scrolling is disabled
                - no shortcuts
                - selection enabled
                - expands downwards

              * Prediction Expanded List:
                - 9 items in the viewport
                - scrolls vertically
                - no shortcuts
                - selection enabled
                - doesn't collapse
                - snaps to item when scrolling

              * Conversion List:
                - 9 items visible
                - scrolls vertically
                - shortcuts for visible area
                - selection enabled
                - expands sideways (to the right)
                - snaps to item when scrolling

              * Conversion Expanded List:
                - 9 rows in column
                - fixed amount of column in viewport (seems to depend on resolution)
                - scrolls horizontally
                - shortcuts for selected column
                - selection enabled
                - collapse sideways (to the left)
                - snaps to column when scrolling
                - fixed column width
      -->
      <Style x:Key="AdaptiveControlVerticalStyleWithExpansion" TargetType="controls:AdaptiveControl">
        <Setter Property="ExpandedListStyle" Value="{StaticResource AdaptiveSuggestionListVerticalStyle}" />
        <Setter Property="ExpandButtonStyle" Value="{StaticResource VerticalSuggestionsListFooterStyle}" />
        <Setter Property="Background" Value="{ThemeResource SystemAltHighColor}" />
        <Setter Property="SuggestionListStyle" Value="{StaticResource AdaptiveSuggestionListVerticalStyle}" />
        <Setter Property="ExpandedItemContainerStyle" Value="{StaticResource VerticalTableViewListItemContainerHardwareKeyboardStyle}" />
        <Setter Property="RequestedTheme" Value="Light" />
        <Setter Property="BorderBrush" Value="{ThemeResource HardwareKeyboardCandidateWindowBorderColor}" />
        <Setter Property="FontFamily" Value="Yu Gothic UI" />
        <Setter Property="KeyboardShortcutAssignmentMode" Value="VisibleItemsOnSelected" />
        <Setter Property="IsTableViewStaticallyPaged" Value="True" />
        <Setter Property="TableViewStaticPagingItemsPerPage" Value="9" />
        <Setter Property="PredictionLineViewWrapSelection" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="controls:AdaptiveControl">
                <Grid Background="{TemplateBinding Background}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Prediction candidate window, unexpanded (less candidates) -->
                    <controls:SelectableListView x:Name="TEMPLATE_PART_AdaptiveSuggestionList"
                                                 Grid.Row="0"
                                                 ResizeListMode="Uniform"
                                                 IsStaticallyPaged="True"
                                                 ItemsInView="5"
                                                 AllowPaddingForLastPage="True"
