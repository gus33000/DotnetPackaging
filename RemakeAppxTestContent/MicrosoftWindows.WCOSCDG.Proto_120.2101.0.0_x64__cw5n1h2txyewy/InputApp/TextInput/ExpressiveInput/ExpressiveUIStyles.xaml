<ResourceDictionary
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls.ExpressiveUIStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls"
    xmlns:converter="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- TODO: http://osgvsowi/16210382 Use BooleanToVisibilityConverter instead of BooleanToBrowseVisibilityConverter -->
    <controls:BooleanToBrowseVisibilityConverter x:Key="BooleanToBrowseVisibilityConverter"/>
    <controls:AnnotationStringToVisibilityValueConverter x:Key="AnnotationStringToVisibilityValueConverter"/>
    <controls:SupportsSkinTonePickerToVisibilityValueConverter x:Key="SupportsSkinTonePickerToVisibilityValueConverter"/>
    <controls:CompactViewListDataTemplateSelector x:Key="CompactViewListDataTemplateSelector"/>
    <controls:GroupedFullViewGroupListDataTemplateSelector x:Key="GroupedFullViewGroupListDataTemplateSelector"/>
    <controls:GroupedFullViewItemGridDataTemplateSelector x:Key="GroupedFullViewItemGridDataTemplateSelector"/>
    <controls:GroupedFullViewItemGridItemContainerStyleSelector x:Key="GroupedFullViewItemGridItemContainerStyleSelector"/>

    <x:String x:Key="AXPMDL2Assets">ms-resource:///Files/InputApp/Assets/Fonts/AXPMDL2.ttf#AXP MDL2 Assets,/Assets/Fonts/AXPMDL2.ttf#AXP MDL2 Assets</x:String>

    <Style x:Key="ExpressiveInputControlCompactViewStyle" TargetType="controls:ExpressiveInputControl" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ExpressiveInputControl">
                    <controls:ExpressiveInputCompactViewControl x:Name="TEMPLATE_PART_ExpressionCompactView"
                                                                Style="{StaticResource ExpressiveInputControlCompactViewControlStyle}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExpressiveInputControlGroupedFullViewStyle" TargetType="controls:ExpressiveInputControl" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ExpressiveInputControl">
                    <controls:ExpressiveInputGroupedFullViewControl x:Name="TEMPLATE_PART_ExpressionGroupedFullView"
                                                             Style="{StaticResource ExpressiveInputControlGroupedFullViewControlStyle}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <CollectionViewSource x:ConnectionId='2' x:Name="ExpressiveInputGroupCompactViewInfoCVS" IsSourceGrouped="true" ItemsPath="Items"/>

    <Style x:Key="ExpressiveInputControlCompactViewControlStyle" TargetType="controls:ExpressiveInputCompactViewControl" >
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ExpressiveInputCompactViewControl">
                    <Grid BorderThickness="{StaticResource ExpressiveInputCompactViewBorderThickness}"
                          BorderBrush="{ThemeResource SystemAccentColor}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Padding="{StaticResource ExpressiveInputCompactViewPadding}"
                          Background="{ThemeResource ExpressiveInputCompactViewBackground}">
                        <controls:ExpressiveInputCompactListView x:Name="TEMPLATE_PART_ExpressionCompactViewList"
                                                                 ItemsSource="{Binding Source={StaticResource ExpressiveInputGroupCompactViewInfoCVS}}"
                                                                 Style="{StaticResource ExpressiveControlVerticalListViewStyle}"
                                                                 ItemTemplateSelector="{StaticResource CompactViewListDataTemplateSelector}"
                                                                 ItemContainerStyle="{StaticResource ExpressiveInputCompactViewListStyle}"
                                                                 VerticalAlignment="Stretch"
                                                                 HorizontalAlignment="Stretch"
                                                                 SelectionMode="Single">
                            <controls:ExpressiveInputCompactListView.GroupStyle>
                                <GroupStyle HidesIfEmpty="True"
                                            HeaderContainerStyle="{StaticResource CompactViewListViewHeaderStyle}"
                                            HeaderTemplate="{StaticResource CompactViewListViewHeaderTemplate}"/>
                            </controls:ExpressiveInputCompactListView.GroupStyle>
                        </controls:ExpressiveInputCompactListView>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CompactViewListViewHeaderStyle" TargetType="ListViewHeaderItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="{StaticResource CompactViewListViewHeaderMargin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewHeaderItem">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center"
                                      Height="{StaticResource CompactViewListViewHeaderHeight}"
                                      Padding="{StaticResource CompactViewListViewHeaderPadding}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="CompactViewListViewHeaderTemplate"                                           >
        <TextBlock x:ConnectionId='182'                     
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource SystemBaseMediumColor}"
                   Typography.Capitals="Titling"/>
    </DataTemplate>

    <CollectionViewSource x:ConnectionId='3' x:Name="ExpressiveInputGroupedFullViewInfoCVS" IsSourceGrouped="true" ItemsPath="Items"/>

    <Style x:Key="ExpressiveInputControlGroupedFullViewControlStyle" TargetType="controls:ExpressiveInputGroupedFullViewControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ExpressiveInputGroupedFullViewControl">
                    <Grid x:Name="TEMPLATE_PART_Grouped_FullView_Panel"
                          BorderBrush="{ThemeResource ExpressiveInputGroupedFullViewGridBorderBrush}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{ThemeResource ExpressiveInputGroupedFullViewPanelBackground}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid 
                            Grid.Row="0"
                            MinHeight="{StaticResource ExpressiveInputGroupedFullViewListViewHeight}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                  x:Name="TEMPLATE_PART_Gripper"
                                  AutomationProperties.AutomationId="MoveGripper"
                                  Background="Transparent"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch">
                                <TextBlock x:Name="TEMPLATE_PART_Search_TextBlock"
                                       Grid.Column="0"
                                       Text=""
                                       FontFamily="Segoe UI"
                                       FontSize="{StaticResource ExpressiveInputGroupedFullViewSearchTipFontSize}"
                                       Foreground="{ThemeResource ExpressiveInputGroupedFullViewGroupSearchTextForeground}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="{StaticResource ExpressiveInputGroupedFullViewSearchTextMargin}"
                                       TextWrapping="Wrap"
                                       IsTextScaleFactorEnabled="True" />
                            </Border>

                            <Button x:Name="TEMPLATE_PART_Close_Button"
                                    Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Style="{StaticResource ExpressiveInputFullViewFunctionBarItemStyle}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Content="&#xE894;"/>
                        </Grid>
                        <ListView x:Name="TEMPLATE_PART_Sets_ListView"
                                  Grid.Row="1"
                                  Padding="{StaticResource ExpressiveInputGroupedFullViewListViewPadding}"
                                  Style="{StaticResource ExpressiveControlHorizontalListViewStyle}"
                                  ItemContainerStyle="{StaticResource ExpressiveInputGroupedFullViewListItemStyle}"
                                  ItemTemplate="{StaticResource ExpressiveInputGroupedFullViewCategoryListItemDataTemplate}"/>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <GridView x:Name="TEMPLATE_PART_Items_GridView"
                                      Grid.Row="0"
                                      ItemsSource="{Binding Source={StaticResource ExpressiveInputGroupedFullViewInfoCVS}}"
                                      Background="{ThemeResource ExpressiveInputGroupedFullViewPanelBackground}"
                                      Style="{StaticResource GridViewStyleWithoutAnimation}"
                                      Padding="{StaticResource ExpressiveInputGroupedFullViewGridViewPadding}"
                                      ItemTemplateSelector ="{StaticResource GroupedFullViewItemGridDataTemplateSelector}"
                                      ItemContainerStyleSelector="{StaticResource GroupedFullViewItemGridItemContainerStyleSelector}">
                                <GridView.GroupStyle>
                                    <GroupStyle HidesIfEmpty="True"
                                                HeaderContainerStyle="{StaticResource GroupedFullViewGridViewHeaderStyle}"
                                                HeaderTemplate="{StaticResource GroupedFullViewGridViewHeaderTemplate}"/>
                                </GridView.GroupStyle>
                            </GridView>

                            <StackPanel x:Name="TEMPLATE_PART_ExpressionSearchTipPanel"
                                        Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource ExpressiveInputGroupedFullViewSearchTipPanelMargin}"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="TEMPLATE_PART_ExpressionGroupedFullViewSearchKaomoji"
                                           FontSize="{StaticResource ExpressiveInputGroupedFullViewSearchKaomojiFontSize}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           FontFamily="Segoe UI"
                                           Foreground="{ThemeResource SystemAccentColor}"/>
                                <TextBlock x:Name="TEMPLATE_PART_ExpressionGroupedFullViewSearchTip"
                                           FontSize="{StaticResource ExpressiveInputGroupedFullViewSearchTipFontSize}"
                                           Foreground="{ThemeResource ExpressiveInputGroupListForeground}"
                                           HorizontalTextAlignment="Center"
                                           FontFamily="Segoe UI"
                                           Margin="{StaticResource ExpressiveInputGroupedFullViewSearchTipMargin}"
                                           IsTextScaleFactorEnabled="True"/>
                            </StackPanel>

                            <StackPanel x:Name="TEMPLATE_PART_ExpressiveInputFODTipPanel"
                                        Grid.Row="0"
                                        Orientation="Vertical"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource ExpressiveInputFullViewFODTipPanelMargin}"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="TEMPLATE_PART_FODText"
                                           Style="{StaticResource ExpressiveInputFODTipTextBlockStyle}"/>
                                <HyperlinkButton x:Name="TEMPLATE_PART_HyperlinkButton" NavigateUri="ms-settings:regionlanguage">
                                    <TextBlock x:Name="TEMPLATE_PART_FODLink"
                                               Style="{StaticResource ExpressiveInputFODTipTextBlockStyle}"
                                               TextDecorations="Underline"/>
                                </HyperlinkButton>
                            </StackPanel>

                            <ListView x:Name="TEMPLATE_PART_Groups_ListView"
                                      Grid.Row="1"
                                      Background="{ThemeResource ExpressiveInputGroupedFullViewPanelBackground}"
                                      Padding="{StaticResource ExpressiveInputGroupedFullViewListViewPadding}"
                                      Style="{StaticResource ExpressiveControlHorizontalListViewStyle}"
                                      ItemTemplateSelector="{StaticResource GroupedFullViewGroupListDataTemplateSelector}"
                                      ItemContainerStyle="{StaticResource ExpressiveInputGroupedFullViewListItemStyle}"
                                      VerticalAlignment="Stretch" 
                                      HorizontalAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                        <StackPanel x:Name="TEMPLATE_PART_Tip_Panel"
                              Grid.Row="3"
                              Background="{ThemeResource ExpressiveInputGroupedFullViewGroupTipTextBackground}"
                              VerticalAlignment="Bottom"
                              Visibility="Collapsed">
                            <TextBlock x:Name="TEMPLATE_PART_Tip_TextBlock"
                                       Grid.Column="0"
                                       TextWrapping="Wrap"
                                       FontSize="{StaticResource ExpressiveInputGroupedFullViewTipFontSize}"
                                       Foreground="{ThemeResource ExpressiveInputGroupedFullViewGroupTipTextForeground}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="{StaticResource ExpressiveInputGroupedFullViewTipTextMargin}" FontFamily="Segoe UI"
                                       IsTextScaleFactorEnabled="True">
                                    <Run x:Name="TEMPLATE_PART_Tip_TextFront"
                                                  Text=""
                                                  FontFamily="Segoe UI"/>
                                    <Run x:Name="TEMPLATE_PART_Tip_TextIcon"
                                                  Text="&#xF23F;"
                                                  FontSize="14"
                                                  FontFamily="{StaticResource AXPMDL2Assets}"/>
                                    <Run x:Name="TEMPLATE_PART_Tip_TextBack"
                                                  Text=""
                                                  FontFamily="Segoe UI"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GroupedFullViewGridViewHeaderStyle" TargetType="GridViewHeaderItem">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewHeaderItem">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      AutomationProperties.AccessibilityView="Raw"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EmojiSkinToneListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="RootGrid"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonGridSize}"
                                  Height="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonGridSize}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="SkinToneEllipse.Width" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonHoveredSize}" />
                                        <Setter Target="SkinToneEllipse.Height" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonHoveredSize}" />
                                        <Setter Target="SkinToneEllipse.StrokeThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="SkinToneEllipse.Width" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonHoveredSize}" />
                                        <Setter Target="SkinToneEllipse.Height" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonHoveredSize}" />
                                        <Setter Target="SkinToneEllipse.StrokeThickness" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="SkinToneEllipse.Width" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonSize}" />
                                        <Setter Target="SkinToneEllipse.Height" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonSize}" />
                                        <Setter Target="SkinToneEllipse.StrokeThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="SkinToneEllipse.Width" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonHoveredSize}" />
                                        <Setter Target="SkinToneEllipse.Height" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonHoveredSize}" />
                                        <Setter Target="SkinToneEllipse.StrokeThickness" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused"/>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="SkinToneEllipse.Width" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonHoveredSize}" />
                                        <Setter Target="SkinToneEllipse.Height" Value="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonHoveredSize}" />
                                        <Setter Target="SkinToneEllipse.StrokeThickness" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Ellipse x:Name="SkinToneEllipse"
                                         Width="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonSize}"
                                         Height="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonSize}"
                                         Fill="{TemplateBinding Content}"
                                         Stroke="{ThemeResource ExpressiveInputFunctionBarItemForeground}"
                                         StrokeThickness="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="GroupedFullViewGridViewHeaderTemplate"                                           >
        <Grid x:ConnectionId='144' HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ListView x:ConnectionId='145' x:Name="SkinTonePanelModifier_ListView"
                      Margin="{StaticResource ExpressiveInputGroupedFullViewSkinToneMargin}"
                      Grid.Column="0"
                      HorizontalAlignment="Left"
                      Style="{StaticResource ExpressiveControlHorizontalListViewStyle}"
                      ItemContainerStyle="{StaticResource EmojiSkinToneListViewItemStyle}"
                                                                         
                                                                                                                                                            >
                <!--ListViewItem content indicated the color of skintone button-->
                <ListViewItem TabIndex="0" Content="{ThemeResource ExpressiveInputGroupedFullViewDefaultSkinTone}"/>
                <ListViewItem TabIndex="1" Content="{ThemeResource ExpressiveInputGroupedFullViewLightSkinTone}"/>
                <ListViewItem TabIndex="2" Content="{ThemeResource ExpressiveInputGroupedFullViewMediumLightSkinTone}"/>
                <ListViewItem TabIndex="3" Content="{ThemeResource ExpressiveInputGroupedFullViewMediumSkinTone}"/>
                <ListViewItem TabIndex="4" Content="{ThemeResource ExpressiveInputGroupedFullViewMediumDarkSkinTone}"/>
                <ListViewItem TabIndex="5" Content="{ThemeResource ExpressiveInputGroupedFullViewDarkSkinTone}"/>
            </ListView>
        </Grid>
    </DataTemplate>

    <Style x:Key="ExpressiveInputGroupedFullViewListItemStyle" TargetType="ListViewItem" >
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="{StaticResource ExpressiveInputGroupedFullViewListViewHeight}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="RootGrid"
                          Margin="{StaticResource ExpressiveInputGroupedFullViewListViewItemMargin}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="ItemPresenter.Foreground" Value="{ThemeResource ExpressiveInputGroupListForeground}" />
                                        <Setter Target="SelectionIndicator.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ItemPresenter.Foreground" Value="{ThemeResource ExpressiveInputGroupListForeground}" />
                                        <Setter Target="ItemPresenter.Background" Value="{ThemeResource ExpressiveInputGroupListHoverBackground}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ItemPresenter.Foreground" Value="{ThemeResource ExpressiveInputGroupListForeground}" />
                                        <Setter Target="ItemPresenter.Background" Value="{ThemeResource ExpressiveInputGroupListPressedBackground}" />
                                        <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemPresenter.Foreground" Value="{ThemeResource ExpressiveInputGroupListSelectedForeground}" />
                                        <Setter Target="ItemPresenter.Background" Value="{ThemeResource ExpressiveInputGroupListSelectedBackground}" />
                                        <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemPresenter.Foreground" Value="{ThemeResource ExpressiveInputGroupListSelectedForeground}" />
                                        <Setter Target="ItemPresenter.Background" Value="{ThemeResource ExpressiveInputGroupListHoverBackground}" />
                                        <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="ItemPresenter.Foreground" Value="{ThemeResource ExpressiveInputGroupListSelectedForeground}" />
                                        <Setter Target="ItemPresenter.Background" Value="{ThemeResource ExpressiveInputGroupListPressedBackground}" />
                                        <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused">
                                    <VisualState.Setters>
                                        <Setter Target="RevealBorder.Visibility" Value="Collapsed"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="RevealBorder.Visibility" Value="Visible"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle
                            x:Name="SelectionIndicator"
                            Width="16"
                            Height="2"
                            Fill="{ThemeResource ExpressiveInputGroupListSelectedForeground}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Visibility = "Collapsed"/>
                        <Border
                            x:Name="RevealBorder"
                            BorderBrush="{ThemeResource ExpressiveInputGroupListForeground}"
                            BorderThickness = "1"
                            Visibility = "Collapsed"/>
                        <ContentPresenter x:Name="ItemPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Top"
                                          AutomationProperties.AccessibilityView="Raw"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:ConnectionId='4' x:Name="ExpressiveInputGroupedFullViewCategoryListItemDataTemplate"                                         >
        <Grid x:ConnectionId='125' HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Width="{StaticResource ExpressiveInputGroupedFullViewItemWidth}" 
              Height="{StaticResource ExpressiveInputGroupedFullViewItemHeight}"
              IsHitTestVisible="True"
              Background="Transparent">
            <ToolTipService.ToolTip>
                <ToolTip x:ConnectionId='126'                                                    />
            </ToolTipService.ToolTip>
            <TextBlock x:ConnectionId='127' x:Name="TEMPLATE_PART_GroupLabel" 
                                             
                                                        
                        FontSize="{StaticResource ExpressiveInputGroupedFullViewGroupListFontSize}"
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:ConnectionId='5' x:Name="ExpressiveInputGroupedFullViewGroupListItemPlainTextDataTemplate"                                           >
        <Grid x:ConnectionId='121' HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Width="{StaticResource ExpressiveInputGroupedFullViewItemWidth}" 
              Height="{StaticResource ExpressiveInputGroupedFullViewItemHeight}"
              IsHitTestVisible="True"
              Background="Transparent"
                                                                                                                  >
            <ToolTipService.ToolTip>
                <ToolTip x:ConnectionId='122'                                                   />
            </ToolTipService.ToolTip>
            <Border x:ConnectionId='123'
                x:Name="RevealBorder"
                BorderBrush="{ThemeResource ExpressiveInputGroupListForeground}"
                BorderThickness = "1"
                                                                                                                             />
            <TextBlock x:ConnectionId='124' x:Name="TEMPLATE_PART_GroupLabel" 
                                            
                                                       
                       FontSize="{StaticResource ExpressiveInputGroupedFullViewGroupListFontSize}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:ConnectionId='6' x:Name="ExpressiveInputGroupedFullViewGroupListItemImageDataTemplate"                                           >
        <Grid x:ConnectionId='117' HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Width="{StaticResource ExpressiveInputGroupedFullViewItemWidth}" 
              Height="{StaticResource ExpressiveInputGroupedFullViewItemHeight}"
              IsHitTestVisible="True"
              Background="Transparent"
                                                                                                                  >
            <ToolTipService.ToolTip>
                <ToolTip x:ConnectionId='118'                                                   />
            </ToolTipService.ToolTip>
            <Border x:ConnectionId='119'
                x:Name="RevealBorder"
                BorderBrush="{ThemeResource ExpressiveInputGroupListForeground}"
                BorderThickness = "1"
                                                                                                                             />
            <Image x:ConnectionId='120' x:Name="TEMPLATE_PART_GroupLabel" 
                                                             
                   Width="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonGridSize}"
                   Height="{StaticResource ExpressiveInputGroupedFullViewSkinToneButtonGridSize}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExpressiveItemControlForAtLocation"                                          >
        <!--this UserControl is added as the root control to make visual state work.-->
        <UserControl x:ConnectionId='107' x:Name="UserControlForAtLocation">
            <controls:ExpressiveInputItemPanel x:ConnectionId='108'
                                                           
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Style="{StaticResource ExpressiveInputItemPanelStretchStyle}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Target="TEMPLATE_PART_Metadata.(TextBlock.Foreground)" Value="{ThemeResource SystemBaseMediumColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="TEMPLATE_PART_Metadata.(TextBlock.Foreground)" Value="{ThemeResource SystemBaseMediumColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOverSelected">
                            <VisualState.Setters>
                                <Setter Target="TEMPLATE_PART_Metadata.(TextBlock.Foreground)" Value="{ThemeResource SystemAltMediumColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Target="TEMPLATE_PART_Metadata.(TextBlock.Foreground)" Value="{ThemeResource SystemAltMediumColor}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
