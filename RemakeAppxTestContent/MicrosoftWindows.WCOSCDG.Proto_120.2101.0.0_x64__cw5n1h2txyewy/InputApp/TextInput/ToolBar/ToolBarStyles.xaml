                        <Border x:Name="TEMPLATE_PART_ToolBarGripper" Grid.Row="0" Background="Transparent"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">
                            <TextBlock Text="&#xE784;" FontSize="16" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource ToolBarLabelBrush}" Opacity="0.4" TextAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>
                        <ListView x:Name="TEMPLATE_PART_ToolBarListView"
                                Grid.Row="1"
                                ScrollViewer.BringIntoViewOnFocusChange="False"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                IsTabStop="True"
                                SelectionMode="None"
                                Padding="0"
                                IsItemClickEnabled="True"
                                ItemTemplate="{StaticResource ChsToolBarItemVerticalTemplate}"
                                ItemContainerStyle="{StaticResource ToolBarItemStyle}"
                                Style="{StaticResource ListViewStyleWithoutAnimation}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.Resources>
                                <MenuFlyout x:Name="TEMPLATE_PART_ToolBarCommonMenuFlyout" MenuFlyout.MenuFlyoutPresenterStyle="{ThemeResource ToolBarMenuFlyoutPresenterStyle}" Placement="Top" AllowFocusOnInteraction="False">
                                    <MenuFlyoutSubItem x:Name="TEMPLATE_PART_ToolBarPersonalizationMenuItem" Style="{StaticResource ChsToolBarPersonalizationMenuItem}">
                                        <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarPersonalizationListMenuItem" Style="{StaticResource ChsToolBarPersonalizationListMenuItem}"/>
                                        <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarResetMenuItem" Style="{StaticResource ChsToolBarResetMenuItem}"/>
                                    </MenuFlyoutSubItem>
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarOrientationMenuItem" Style="{StaticResource ChsToolBarCommonMenuItem}"/>
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarHideMenuItem" Style="{StaticResource ChsToolBarCommonMenuItem}"/>
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarSettingsMenuItem" Style="{StaticResource ChsToolBarCommonMenuItem}"/>
                                </MenuFlyout>
                                <MenuFlyout x:Name="TEMPLATE_PART_ToolBarEmojiMenuFlyout" MenuFlyout.MenuFlyoutPresenterStyle="{ThemeResource ToolBarMenuFlyoutPresenterStyle}" Placement="Top" AllowFocusOnInteraction="False">
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarEmojiListMenuItem" Style="{StaticResource ChsToolBarEmojiListMenuItem}"/>
                                </MenuFlyout>
                                <MenuFlyout x:Name="TEMPLATE_PART_ToolBarSIPMenuFlyout" MenuFlyout.MenuFlyoutPresenterStyle="{ThemeResource ToolBarMenuFlyoutPresenterStyle}" Placement="Top" AllowFocusOnInteraction="False">
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarSIPListMenuItem" Style="{StaticResource ChsToolBarSIPListMenuItem}"/>
                                </MenuFlyout>
                            </ListView.Resources>
                        </ListView>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ChsToolBarItemHorizontalTemplate"                                     >
        <Grid x:ConnectionId='154' Background="Transparent" AutomationProperties.AccessibilityView="Raw"                                                                 >
            <TextBlock x:ConnectionId='155' x:Name="TEMPLATE_PART_ChsToolBarItemButton"
                                                       
                                                               
                                                             
                                                                 
                    Foreground="{ThemeResource ToolBarLabelBrush}"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    IsHitTestVisible="False"
                    AutomationProperties.AccessibilityView="Raw">
            </TextBlock>
            <ToolTipService.ToolTip>
                <ToolTip Background="{ThemeResource ToolBarToolTipBackgroundBrush}">
                    <TextBlock x:ConnectionId='156' Margin="5,4,5,4"                                      Style="{StaticResource ToolBarToolTipTextStyle}"/>
                </ToolTip>
            </ToolTipService.ToolTip>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ChsToolBarItemVerticalTemplate"                                     >
        <!-- need a Grid to make text vertically center aligned -->
        <Grid x:ConnectionId='150'                                       Background="Transparent" AutomationProperties.AccessibilityView="Raw"                                                                 >
