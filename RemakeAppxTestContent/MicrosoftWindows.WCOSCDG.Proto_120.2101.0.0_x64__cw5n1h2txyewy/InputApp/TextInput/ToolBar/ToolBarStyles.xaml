                    AutomationProperties.AccessibilityView="Raw">
            </TextBlock>
            <ToolTipService.ToolTip>
                <ToolTip Background="{ThemeResource ToolBarToolTipBackgroundBrush}">
                    <TextBlock x:ConnectionId='152' Margin="5,4,5,4"                                      Style="{StaticResource ToolBarToolTipTextStyle}"/>
                </ToolTip>
            </ToolTipService.ToolTip>
        </Grid>
    </DataTemplate>

    <Style x:Key="ChsToolBarStyle" TargetType="controls:ToolBarControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ToolBarControl">
                    <controls:ChsToolBarList x:Name="TEMPLATE_PART_ToolBarList" Margin="0"/>
