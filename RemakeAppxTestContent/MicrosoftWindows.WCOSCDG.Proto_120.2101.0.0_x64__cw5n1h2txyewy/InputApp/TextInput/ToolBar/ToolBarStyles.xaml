                    <ListViewItemPresenter PressedBackground="{ThemeResource ToolBarItemBackgroundPressedAccentBrush}" PointerOverBackground="{ThemeResource ToolBarItemBackgroundPointerOverAccentBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolBarToolTipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{ThemeResource ToolBarLabelBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ToolBarContextMenuItemStyle" TargetType="SelectorItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter PressedBackground="{ThemeResource ToolBarPopupButtonBackgroundPressedBrush}" PointerOverBackground="{ThemeResource ToolBarPopupButtonBackgroundPointerOverBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolBarPopupButtonStyle" TargetType="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="13,0,0,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background" Storyboard.TargetName="RootGrid">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <PointerUpThemeAnimation Storyboard.TargetName="RootGrid"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background" Storyboard.TargetName="RootGrid">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolBarPopupButtonBackgroundPointerOverBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <PointerUpThemeAnimation Storyboard.TargetName="RootGrid"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background" Storyboard.TargetName="RootGrid">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ToolBarPopupButtonBackgroundPressedBrush}"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <PointerDownThemeAnimation Storyboard.TargetName="RootGrid"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter" AutomationProperties.AccessibilityView="Raw" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTransitions="{TemplateBinding ContentTransitions}" Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolBarPopupButtonIconStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Margin" Value="12,0,12,0"/>
        <Setter Property="Foreground" Value="{ThemeResource ToolBarLabelBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ToolBarPopupButtonTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{ThemeResource ToolBarLabelBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ToolBarMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource ToolBarPopupButtonBackgroundBrush}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0,1,0,1"/>
        <Setter Property="BorderBrush" Value="#767676"/>
    </Style>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ToolBarToolTipBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundBrush" Color="#1F1F1F" />
            <AcrylicBrush x:Key="ToolBarBackgroundAcrylicBrush" BackgroundSource="Backdrop" TintColor="#1F1F1F" FallbackColor="#1F1F1F" TintOpacity="0.5" />
            <SolidColorBrush x:Key="ToolBarItemBackgroundPointerOverBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8" />
            <SolidColorBrush x:Key="ToolBarItemBackgroundPressedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9" />
            <SolidColorBrush x:Key="ToolBarLabelBrush" Color="{StaticResource XboxClrVideoSafeWhiteColor}" />
            <AcrylicBrush x:Key="ToolBarPopupButtonBackgroundAcrylicBrush" BackgroundSource="HostBackdrop" TintColor="#1F1F1F" FallbackColor="#1F1F1F" TintOpacity="0.5" />
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundPointerOverBrush" Color="{StaticResource XboxClrVideoSafeWhiteColor}" Opacity="0.2" />
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundPressedBrush" Color="{StaticResource XboxClrVideoSafeWhiteColor}" Opacity="0.2" />

            <!-- Accent style colors -->
            <SolidColorBrush x:Key="ToolBarBackgroundAccentBrush" Color="{ThemeResource SystemAccentColorDark3}" />
            <SolidColorBrush x:Key="ToolBarItemBackgroundPointerOverAccentBrush" Color="{ThemeResource SystemAccentColorDark2}" />
            <SolidColorBrush x:Key="ToolBarItemBackgroundPressedAccentBrush" Color="{ThemeResource SystemAccentColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ToolBarToolTipBackgroundBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundBrush" Color="#EEEEEE" />
            <AcrylicBrush x:Key="ToolBarBackgroundAcrylicBrush" BackgroundSource="Backdrop" TintColor="#EEEEEE" FallbackColor="#EEEEEE" TintOpacity="0.5" />
            <SolidColorBrush x:Key="ToolBarItemBackgroundPointerOverBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.8" />
            <SolidColorBrush x:Key="ToolBarItemBackgroundPressedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.9" />
            <SolidColorBrush x:Key="ToolBarLabelBrush" Color="{StaticResource XboxClrVideoSafeBlackColor}" />
            <AcrylicBrush x:Key="ToolBarPopupButtonBackgroundAcrylicBrush" BackgroundSource="HostBackdrop" TintColor="#EEEEEE" FallbackColor="#EEEEEE" TintOpacity="0.5" />
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundPointerOverBrush" Color="{StaticResource XboxClrVideoSafeBlackColor}" Opacity="0.2" />
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundPressedBrush" Color="{StaticResource XboxClrVideoSafeBlackColor}" Opacity="0.2" />

            <!-- Accent style colors -->
            <SolidColorBrush x:Key="ToolBarBackgroundAccentBrush" Color="{ThemeResource SystemAccentColorDark3}" />
            <SolidColorBrush x:Key="ToolBarItemBackgroundPointerOverAccentBrush" Color="{ThemeResource SystemAccentColorDark2}" />
            <SolidColorBrush x:Key="ToolBarItemBackgroundPressedAccentBrush" Color="{ThemeResource SystemAccentColor}" />
        </ResourceDictionary>

        <!--
            This covers all High Contrast Themes as long as the standard High Contrast colors are used (ThemeResource SystemColor)
        -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ToolBarToolTipBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ToolBarBackgroundAcrylicBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="ToolBarItemBackgroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ToolBarItemBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ToolBarLabelBrush" Color="{StaticResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundAcrylicBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundPointerOverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ToolBarPopupButtonBackgroundPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>

            <!-- Accent style colors -->
            <SolidColorBrush x:Key="ToolBarBackgroundAccentBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="ToolBarItemBackgroundPointerOverAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="ToolBarItemBackgroundPressedAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

