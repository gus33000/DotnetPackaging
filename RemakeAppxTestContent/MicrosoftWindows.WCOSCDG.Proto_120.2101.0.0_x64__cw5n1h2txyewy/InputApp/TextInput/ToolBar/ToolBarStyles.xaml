    <!-- For context menus -->
    <Style x:Key="ChsToolBarPersonalizationMenuItem" TargetType="MenuFlyoutSubItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutSubItem">
                    <Button x:Name="TEMPLATE_PART_ToolBarPersonalizationButton" Style="{StaticResource ToolBarPopupButtonStyle}" AutomationProperties.AccessibilityView="Raw">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource ToolBarCommonMenuLabelWidth}"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource ToolBarMenuButtonHeight}"></RowDefinition>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{TemplateBinding Text}" Style="{StaticResource ToolBarPopupButtonTextStyle}" AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="&#xE00F;" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource ToolBarLabelBrush}" FontSize="12" FontFamily="Segoe MDL2 Assets" Margin="0,0,16,0" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
