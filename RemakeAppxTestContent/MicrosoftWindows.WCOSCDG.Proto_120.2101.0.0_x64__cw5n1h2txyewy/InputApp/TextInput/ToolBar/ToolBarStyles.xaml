                <ControlTemplate TargetType="MenuFlyoutItem">
                    <Button x:Name="TEMPLATE_PART_ToolBarResetButton" Style="{StaticResource ToolBarPopupButtonStyle}" HorizontalContentAlignment="Stretch" AutomationProperties.AccessibilityView="Raw">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource ToolBarPersonalizationMenuCheckMarkWidth}"></ColumnDefinition>
