<ResourceDictionary
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls.ToolBarStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <GridLength x:Key="ToolBarGripperLength">16</GridLength>
    <GridLength x:Key="ToolBarTailLength">4</GridLength>
    <GridLength x:Key="ToolBarMenuButtonHeight">32</GridLength>
    <GridLength x:Key="ToolBarCommonMenuLabelWidth">147</GridLength> <!-- Common menu total width = 13 (left margin) + 147 = 160 -->
    <GridLength x:Key="ToolBarPersonalizationMenuCheckMarkWidth">12</GridLength>
    <GridLength x:Key="ToolBarPersonalizationMenuItemIconWidth">40</GridLength>
    <GridLength x:Key="ToolBarPersonalizationMenuLabelWidth">135</GridLength> <!-- Personalization menu total width = 13 (left margin) + 12 + 40 + 135 = 200 -->
    <GridLength x:Key="JpnToolBarSelectablePaddingWidth">12</GridLength> <!-- Personalization menu total width = 13 (left margin) + 12 + 12 + 163 = 200 -->
    <GridLength x:Key="JpnToolBarSelectableLabelWidth">163</GridLength> <!-- Personalization menu total width = 13 (left margin) + 12 + 12 + 163 = 200 -->
    <x:Double x:Key="ToolBarLogonUIWidth">48.0</x:Double>
    <x:Double x:Key="ToolBarLogonUIHeight">48.0</x:Double>

    <!-- For CHS ToolBar -->
    <Style x:Key="ChsToolBarListHorizontalStyle" TargetType="controls:ChsToolBarList" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ChsToolBarList">
                    <Grid Background="{ThemeResource ToolBarBackgroundAcrylicBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource ToolBarGripperLength}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource ToolBarTailLength}"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TEMPLATE_PART_ToolBarGripper" Grid.Column="0" Background="Transparent"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0">
                            <TextBlock Text="&#xE784;" FontSize="16" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource ToolBarLabelBrush}" Opacity="0.4" VerticalAlignment="Center" />
                        </Border>
                        <ListView x:Name="TEMPLATE_PART_ToolBarListView"
                                Grid.Column="1"
                                ScrollViewer.BringIntoViewOnFocusChange="False"
                                ScrollViewer.HorizontalScrollMode="Disabled"
                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                IsTabStop="True"
                                SelectionMode="None"
                                Padding="0"
                                IsItemClickEnabled="True"
                                ItemTemplate="{StaticResource ChsToolBarItemHorizontalTemplate}"
                                ItemContainerStyle="{StaticResource ToolBarItemStyle}"
                                Style="{StaticResource ListViewStyleWithoutAnimation}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.Resources>
                                <MenuFlyout x:Name="TEMPLATE_PART_ToolBarCommonMenuFlyout" MenuFlyout.MenuFlyoutPresenterStyle="{ThemeResource ToolBarMenuFlyoutPresenterStyle}" Placement="Top" AllowFocusOnInteraction="False">
                                    <MenuFlyoutSubItem x:Name="TEMPLATE_PART_ToolBarPersonalizationMenuItem" Style="{StaticResource ChsToolBarPersonalizationMenuItem}">
                                        <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarPersonalizationListMenuItem" Style="{StaticResource ChsToolBarPersonalizationListMenuItem}"/>
                                        <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarResetMenuItem" Style="{StaticResource ChsToolBarResetMenuItem}"/>
                                    </MenuFlyoutSubItem>
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarOrientationMenuItem" Style="{StaticResource ChsToolBarCommonMenuItem}"/>
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarHideMenuItem" Style="{StaticResource ChsToolBarCommonMenuItem}"/>
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarSettingsMenuItem" Style="{StaticResource ChsToolBarCommonMenuItem}"/>
                                </MenuFlyout>
                                <MenuFlyout x:Name="TEMPLATE_PART_ToolBarEmojiMenuFlyout" MenuFlyout.MenuFlyoutPresenterStyle="{ThemeResource ToolBarMenuFlyoutPresenterStyle}" Placement="Top" AllowFocusOnInteraction="False">
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarEmojiListMenuItem" Style="{StaticResource ChsToolBarEmojiListMenuItem}"/>
                                </MenuFlyout>
                                <MenuFlyout x:Name="TEMPLATE_PART_ToolBarSIPMenuFlyout" MenuFlyout.MenuFlyoutPresenterStyle="{ThemeResource ToolBarMenuFlyoutPresenterStyle}" Placement="Top" AllowFocusOnInteraction="False">
                                    <controls:ToolBarMenuFlyoutItem x:Name="TEMPLATE_PART_ToolBarSIPListMenuItem" Style="{StaticResource ChsToolBarSIPListMenuItem}"/>
                                </MenuFlyout>
                            </ListView.Resources>
                        </ListView>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChsToolBarListVerticalStyle" TargetType="controls:ChsToolBarList" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ChsToolBarList">
                    <Grid Background="{ThemeResource ToolBarBackgroundAcrylicBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource ToolBarGripperLength}"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="{StaticResource ToolBarTailLength}"/>
