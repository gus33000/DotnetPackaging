                            <TextBlock Grid.Column="2" Grid.Row="0" Text="{TemplateBinding Text}" Style="{StaticResource ToolBarPopupButtonTextStyle}" HorizontalAlignment="Stretch" AutomationProperties.AccessibilityView="Raw"/>
                        </Grid>
