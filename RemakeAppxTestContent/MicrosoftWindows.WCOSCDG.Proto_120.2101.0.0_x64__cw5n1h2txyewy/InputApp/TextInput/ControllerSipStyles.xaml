    <!--  Color Themes definitions  -->
    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Style x:Key="ControllerKeyboardBackgroundStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControllerKeyboardBackgroundBrush}" />
    </Style>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!--  xbox colors and brushes  -->
            <Color x:Key="XboxSystemPrimaryColor">#1F1F1F</Color>
            <Color x:Key="XboxSystemSecondaryColor">#303030</Color>
            <!--  /xbox colors and brushes  -->

            <!--  child key brushes  -->
            <SolidColorBrush x:Key="ControllerChildKeyBackgroundBrush" Color="{StaticResource WhiteColor}" />
            <SolidColorBrush x:Key="ControllerChildKeyLabelBrush" Color="{StaticResource BlackColor}" />
            <SolidColorBrush x:Key="ControllerChildKeyHighContrastBorderBrush" Color="Transparent" />
            <Thickness x:Key="ControllerChildKeyHighContrastBorderThickness">0</Thickness>
            <!--  /child key brushes  -->

            <SolidColorBrush x:Key="ControllerKeyboardBackgroundBrush" Color="{StaticResource BlackColor}" />

            <!--  key brushes  -->
            <SolidColorBrush x:Key="ButtonYForegroundBrush" Color="#FFA21A" />
            <SolidColorBrush x:Key="ButtonXForegroundBrush" Color="#0094CE" />
            <SolidColorBrush x:Key="ControllerFunctionalKeyBackgroundBrush" Color="{ThemeResource XboxSystemSecondaryColor}" />
            <SolidColorBrush x:Key="ControllerKeyBackgroundBrush" Color="{ThemeResource XboxSystemPrimaryColor}" />
