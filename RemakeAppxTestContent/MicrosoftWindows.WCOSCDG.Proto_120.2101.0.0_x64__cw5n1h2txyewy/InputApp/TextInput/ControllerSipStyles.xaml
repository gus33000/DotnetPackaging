                    <Border x:Name="TEMPLATE_PART_ButtonRootBorder"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="TEMPLATE_PART_ButtonRootBorder.Background" Value="{ThemeResource ControllerKeySelectedBackgroundBrush}" />
                                        <Setter Target="TEMPLATE_PART_ButtonContent.Foreground" Value="{ThemeResource ControllerKeySelectedLabelBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="TEMPLATE_PART_ButtonRootBorder.Background" Value="{ThemeResource ControllerKeySelectedBackgroundBrush}" />
                                        <Setter Target="TEMPLATE_PART_ButtonContent.Foreground" Value="{ThemeResource ControllerKeySelectedLabelBrush}" />
