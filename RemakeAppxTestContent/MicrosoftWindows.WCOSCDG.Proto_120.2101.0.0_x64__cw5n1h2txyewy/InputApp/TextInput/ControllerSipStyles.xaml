    <Style x:Key="ControllerDictationStateErrorControlStyle" TargetType="controls:DictationStateErrorControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DictationStateErrorControl">
                    <Grid>
                        <ScrollViewer x:Name="TEMPLATE_PART_DictationTextContainer"
                                      Margin="0"
                                      Padding="0"
                                      AutomationProperties.AccessibilityView="Raw"
                                      CharacterSpacing="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Disabled"
                                      IsEnabled="True"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Margin="10,0,30,0"
                                           Foreground="{ThemeResource ControllerKeyLabelBrush}"
                                           FontFamily="Segoe Xbox MDL2 Symbol"
                                           FontSize="28"
                                           Text="&#xE37B;" />
                                <TextBlock x:Name="TEMPLATE_PART_DictationTextBlock"
                                           Grid.Column="1"
                                           Margin="0"
                                           Padding="0"
                                           Foreground="{ThemeResource ControllerKeyLabelBrush}"
                                           FontSize="15"
                                           FontWeight="Normal"
                                           AutomationProperties.AccessibilityView="Content"
                                           AutomationProperties.AutomationId="DictationStateErrorBlock"
                                           LineStackingStrategy="MaxHeight"
                                           TextWrapping="WrapWholeWords" />
                                <!--
                                    Deliberately make the text in the hyperlink the same as the keyboard background
                                    as it cannot be selected and the Xbox shell will open a modal dialog instead
                                -->
                                <HyperlinkButton x:Name="TEMPLATE_PART_DictationTextHyperlink"
                                                 Grid.Column="1"
                                                 Margin="0"
                                                 Padding="0"
                                                 Foreground="{ThemeResource ControllerKeyboardBackgroundBrush}"
                                                 AutomationProperties.AccessibilityView="Control"
                                                 AutomationProperties.AutomationId="DictationStateErrorHyperlink">
                                    <TextBlock x:Name="TEMPLATE_PART_DictationTextHyperlinkBlock"
                                               Grid.Column="1"
                                               Margin="0"
                                               Padding="0"
                                               FontSize="15"
                                               FontWeight="Normal"
                                               AutomationProperties.AccessibilityView="Raw"
                                               LineStackingStrategy="MaxHeight"
                                               TextDecorations="Underline"
                                               TextWrapping="WrapWholeWords" />
                                </HyperlinkButton>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

