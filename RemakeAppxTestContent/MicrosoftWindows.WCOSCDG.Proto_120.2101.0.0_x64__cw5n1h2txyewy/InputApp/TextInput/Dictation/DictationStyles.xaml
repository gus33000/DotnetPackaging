<ResourceDictionary
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls.DictationStyles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Style x:Key="DictationButtonStyle" TargetType="controls:SimpleButton" BasedOn="{StaticResource DefaultSimpleButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SimpleButton">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateLabelBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DefaultButtonPointerOverBackgroundColor}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Processing">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DefaultButtonSelectedBackgroundColor}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DefaultButtonSelectedForegroundColor}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DefaultButtonPressedBackgroundColor}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DefaultButtonPressedForegroundColor}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter"
                                          AutomationProperties.AccessibilityView="Raw"
                                          Padding="{TemplateBinding Padding}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DictationMicrophoneButtonStyle" TargetType="controls:DictationMicrophoneButton">
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DictationMicrophoneButton">
                    <controls:SimpleButton x:Name="TEMPLATE_PART_DictationButton"
                        Content="&#xE720;"
                        Background="{ThemeResource WideNarrowCandidateItemPanelBackgroundBrush}"
                        Foreground="{ThemeResource WideNarrowCandidateLabelBrush}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.AccessibilityView="Control"
                        AutomationProperties.AutomationId="DictationMicrophoneButton"
                        Style="{StaticResource DictationButtonStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DictationSwitchButtonStyle" TargetType="controls:DictationSwitchButton">
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DictationSwitchButton">
                    <controls:SimpleButton x:Name="TEMPLATE_PART_DictationButton"
                        Content=""
                        Background="{ThemeResource WideNarrowCandidateItemPanelBackgroundBrush}"
                        Foreground="{ThemeResource WideNarrowCandidateLabelBrush}"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.AccessibilityView="Control"
                        AutomationProperties.AutomationId="DictationSwitchButton"
                        Style="{StaticResource DictationButtonStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DictationStateErrorControlStyle" TargetType="controls:DictationStateErrorControl">
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DictationStateErrorControl">
                    <ScrollViewer x:Name="TEMPLATE_PART_DictationTextContainer"
                        Margin="0"
                        Padding="0"
                        CharacterSpacing="1"
                        IsEnabled="True"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden"
                        AutomationProperties.AccessibilityView="Raw">
                        <Grid>
                            <TextBlock x:Name="TEMPLATE_PART_DictationTextBlock"
                                Margin="0"
                                Padding="0"
                                FontSize="15"
                                FontWeight="Normal"
                                TextWrapping="WrapWholeWords"
                                LineStackingStrategy="MaxHeight"
                                Foreground="{ThemeResource DictationStateErrorBlockBrush}"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="DictationStateErrorBlock" />
                            <HyperlinkButton x:Name="TEMPLATE_PART_DictationTextHyperlink"
                                Margin="0"
                                Padding="0"
                                Foreground="{ThemeResource DictationStateErrorHyperLinkBrush}"
                                AutomationProperties.AccessibilityView="Control"
                                AutomationProperties.AutomationId="DictationStateErrorHyperlink">
                                <TextBlock x:Name="TEMPLATE_PART_DictationTextHyperlinkBlock"
                                    Margin="0"
                                    Padding="0"
                                    FontSize="15"
                                    FontWeight="Normal"
                                    TextDecorations="Underline"
                                    TextWrapping="WrapWholeWords"
                                    LineStackingStrategy="MaxHeight"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </HyperlinkButton>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DictationHintControlStyle" TargetType="controls:DictationHintControl">
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DictationHintControl">
                    <ScrollViewer x:Name="TEMPLATE_PART_DictationTextContainer"
                        Margin="0"
                        Padding="0"
                        CharacterSpacing="1"
                        IsEnabled="True"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollMode="Disabled"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Hidden"
                        AutomationProperties.AccessibilityView="Raw">
                        <Grid>
                            <TextBlock x:Name="TEMPLATE_PART_DictationTextBlock"
                                Margin="0"
                                Padding="0"
                                FontSize="15"
                                FontWeight="SemiLight"
                                TextWrapping="WrapWholeWords"
                                LineStackingStrategy="MaxHeight"
                                Foreground="{ThemeResource DictationHintBlockBrush}"
                                AutomationProperties.AccessibilityView="Content"
                                AutomationProperties.AutomationId="DictationHintBlock" />
                            <HyperlinkButton x:Name="TEMPLATE_PART_DictationTextHyperlink"
                                Margin="0"
                                Padding="0"
                                Foreground="{ThemeResource DictationHintHyperLinkBrush}"
                                AutomationProperties.AccessibilityView="Control"
                                AutomationProperties.AutomationId="DictationHintHyperlink">
                                <TextBlock x:Name="TEMPLATE_PART_DictationTextHyperlinkBlock"
                                    Margin="0"
                                    Padding="0"
                                    FontSize="15"
                                    FontWeight="SemiLight"
                                    TextDecorations="Underline"
                                    TextWrapping="WrapWholeWords"
                                    LineStackingStrategy="MaxHeight"
                                    AutomationProperties.AccessibilityView="Raw" />
                            </HyperlinkButton>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DictationCompactViewWithAdaptiveControlStyle" TargetType="controls:InputPanelControl" >
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:InputPanelControl">
                    <Border x:Name="TEMPLATE_PART_InputPanelBorder" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Style="{StaticResource WideNarrowKeyboardBackgroundStyle}">
                        <controls:PointerInputPanel x:Name="TEMPLATE_PART_PointerInputPanel" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0">
                            <Grid x:Name="TEMPLATE_PART_InputPanelGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" x:Name="TEMPLATE_PART_BackgroundLeftColumn" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="*" x:Name="TEMPLATE_PART_BackgroundRightColumn" />
                                </Grid.ColumnDefinitions>
                                <controls:KeyboardGrid Grid.Column="1" x:Name="TEMPLATE_PART_KeyboardGrid" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0" Visibility="Collapsed" />
                                <controls:AdaptiveControl Grid.Column="1" x:Name="TEMPLATE_PART_CandidateBar" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0" />
                            </Grid>
                        </controls:PointerInputPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DictationCompactViewAdaptiveControlHorizontalStyle" TargetType="controls:AdaptiveControl" BasedOn="{StaticResource InputPanelAdaptiveControlBaseStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:AdaptiveControl">
                    <Grid x:Name="TEMPLATE_PART_AdaptiveControlRoot">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Grid.ColumnSpan="6"
                            x:Name="TEMPLATE_PART_Gripper"
                            Background="{TemplateBinding Background}"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="MoveGripper"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

                        <controls:KeyboardSettingsMenuKey
                            Grid.Column="0"
                            x:Name="TEMPLATE_PART_KeyboardSettingsMenuKey"
                            Style="{StaticResource KeyboardSettingsMenuKeyStyle}" />

                        <controls:DictationMicrophoneButton
                            Grid.Column="1"
                            x:Name="TEMPLATE_PART_DictationMicrophoneButton"
                            Background="{TemplateBinding Background}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed"
                            Style="{StaticResource DictationMicrophoneButtonStyle}" />

                        <controls:DictationStateErrorControl
                            Grid.Column="2"
                            x:Name="TEMPLATE_PART_DictationStateErrorControl"
                            Background="{TemplateBinding Background}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Style="{StaticResource DictationStateErrorControlStyle}" />

                        <controls:DictationHintControl
                            Grid.Column="2"
                            x:Name="TEMPLATE_PART_DictationHintControl"
                            Background="{TemplateBinding Background}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Style="{StaticResource DictationHintControlStyle}" />

                        <controls:SelectableListView
                            Grid.Column="2"
                            x:Name="TEMPLATE_PART_AdaptiveSuggestionList"
                            Background="{TemplateBinding Background}"
                            Style="{TemplateBinding SuggestionListStyle}">
                        </controls:SelectableListView>

                        <controls:DictationSwitchButton
                            Grid.Column="3"
                            x:Name="TEMPLATE_PART_DictationSwitchButton"
                            Background="{TemplateBinding Background}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed"
                            Style="{StaticResource DictationSwitchButtonStyle}" />

                        <controls:SimpleButton
                            Grid.Column="4"
                            x:Name="TEMPLATE_PART_CloseButton"
                            Style="{StaticResource CloseButtonStyle}"
                            AutomationProperties.AutomationId="CloseButton" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DictationPanelControlStyle" TargetType="controls:DictationPanelControl" >
        <Setter Property="AllowFocusOnInteraction" Value="False"/>
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource DictationPanelBackgroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DictationPanelControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" x:Name="TEMPLATE_PART_BackgroundLeftColumn" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" x:Name="TEMPLATE_PART_BackgroundRightColumn" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0" Grid.ColumnSpan="5"
                            x:Name="TEMPLATE_PART_Gripper"
                            Background="{TemplateBinding Background}"
                            AutomationProperties.AutomationId="MoveGripper"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />

                        <controls:DictationMicrophoneButton
                            Grid.Column="1"
                            x:Name="TEMPLATE_PART_DictationMicrophoneButton"
                            Background="{TemplateBinding Background}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Visibility="Collapsed"
                            Style="{StaticResource DictationMicrophoneButtonStyle}" />

                        <controls:DictationStateErrorControl
                            Grid.Column="2"
                            x:Name="TEMPLATE_PART_DictationStateErrorControl"
                            Background="{TemplateBinding Background}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Style="{StaticResource DictationStateErrorControlStyle}" />

                        <controls:DictationHintControl
                            Grid.Column="2"
                            x:Name="TEMPLATE_PART_DictationHintControl"
                            Background="{TemplateBinding Background}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Style="{StaticResource DictationHintControlStyle}" />

                        <controls:SimpleButton
                            Grid.Column="3"
                            x:Name="TEMPLATE_PART_CloseButton"
                            Style="{StaticResource DictationPanelCloseButtonStyle}"
                            AutomationProperties.AutomationId="CloseButton" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DictationPanelControlAcrylicStyle" TargetType="controls:DictationPanelControl" BasedOn="{StaticResource DictationPanelControlStyle}">
        <Setter Property="Background" Value="{ThemeResource DictationPanelBackgroundAcrylicBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DictationPanelBorderBrush}" />
    </Style>

    <Style x:Key="DictationPanelCloseButtonStyle" TargetType="controls:SimpleButton" BasedOn="{StaticResource CloseButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SimpleButton">
                    <Border
                        x:Name="TEMPLATE_PART_SimpleButtonRootBorder"
                        IsHitTestVisible="True"
                        Padding="{TemplateBinding Padding}"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_SimpleButtonRootBorder"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_SimpleButtonRootBorder"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DictationPanelCloseButtonPointerOverBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_SimpleButtonContent"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DictationPanelCloseButtonPointerOverForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_SimpleButtonRootBorder"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DictationPanelCloseButtonPressedBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_SimpleButtonContent"
                                                                       Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource DictationPanelCloseButtonPressedForegroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <TextBlock
                            x:Name="TEMPLATE_PART_SimpleButtonContent"
                            Text="{TemplateBinding ButtonText}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            FontSize="{TemplateBinding FontSize}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- dictation panel brushes -->
            <AcrylicBrush x:Key="DictationPanelBackgroundAcrylicBrush" BackgroundSource="Backdrop" TintColor="#1F1F1F" FallbackColor="#444444" TintOpacity="0.8" />
            <SolidColorBrush x:Key="DictationPanelBackgroundBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="DictationPanelBorderBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPointerOverBackgroundBrush" Color="#E81123" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPointerOverForegroundBrush" Color="{StaticResource XboxClrVideoSafeWhiteColor}" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPressedBackgroundBrush" Color="#F1707A" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPressedForegroundBrush" Color="{StaticResource XboxClrVideoSafeBlackColor}" />
            <!-- dictation control brushes -->
            <SolidColorBrush x:Key="DictationHintBlockBrush" Color="#FFFFFF" Opacity="0.4" />
            <SolidColorBrush x:Key="DictationHintHyperLinkBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DictationStateErrorBlockBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DictationStateErrorHyperLinkBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- dictation panel brushes -->
            <AcrylicBrush x:Key="DictationPanelBackgroundAcrylicBrush" BackgroundSource="Backdrop" TintColor="#DADADA" FallbackColor="#DADADA" TintOpacity="0.8" />
            <SolidColorBrush x:Key="DictationPanelBackgroundBrush" Color="#DADADA" />
            <SolidColorBrush x:Key="DictationPanelBorderBrush" Color="#878787" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPointerOverBackgroundBrush" Color="#E81123" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPointerOverForegroundBrush" Color="{StaticResource XboxClrVideoSafeWhiteColor}" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPressedBackgroundBrush" Color="#F1707A" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPressedForegroundBrush" Color="{StaticResource XboxClrVideoSafeBlackColor}" />
            <!-- dictation control brushes -->
            <SolidColorBrush x:Key="DictationHintBlockBrush" Color="#000000" Opacity="0.6" />
            <SolidColorBrush x:Key="DictationHintHyperLinkBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DictationStateErrorBlockBrush" Color="#000000" />
            <SolidColorBrush x:Key="DictationStateErrorHyperLinkBrush" Color="{ThemeResource SystemAccentColorDark1}" />
        </ResourceDictionary>

        <!--
            This covers all High Contrast Themes as long as the standard High Contrast colors are used (ThemeResource SystemColor)
        -->
        <ResourceDictionary x:Key="HighContrast">
            <!-- dictation panel brushes -->
            <SolidColorBrush x:Key="DictationPanelBackgroundAcrylicBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DictationPanelBackgroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DictationPanelBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPointerOverBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPointerOverForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPressedBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="DictationPanelCloseButtonPressedForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <!-- dictation control brushes -->
            <SolidColorBrush x:Key="DictationHintBlockBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DictationHintHyperLinkBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="DictationStateErrorBlockBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="DictationStateErrorHyperLinkBrush" Color="{ThemeResource SystemColorHotlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

