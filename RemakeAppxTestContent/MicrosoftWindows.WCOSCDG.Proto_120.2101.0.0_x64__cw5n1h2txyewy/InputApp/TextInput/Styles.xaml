                                           HorizontalAlignment="Stretch"/>
                            </Grid>
                        </ScrollViewer>
                        <HyperlinkButton x:Name="TEMPLATE_PART_HandwritingTipButton"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TEMPLATE_PART_HandwritingTipText"
                                           Foreground="{ThemeResource HandwritingTipTextColor}"
                                           TextLineBounds="TrimToBaseline"
                                           Margin="0,0,0,8"
                                           TextDecorations="Underline"
                                           FontSize="15">
                                </TextBlock>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Foreground="{ThemeResource HandwritingTipTextColor}"
                                           FontSize="16"
                                           Margin="8,0,8,4"
                                           TextLineBounds="TrimToBaseline"
                                           VerticalAlignment="Bottom">&#xF45E;</TextBlock>
                            </StackPanel>
                        </HyperlinkButton>
                        <controls:ScrollButton x:Name="TEMPLATE_PART_HandwritingCanvasLeftScrollButton"
                                Style="{StaticResource ScrollButtonStyle}"
                                Opacity="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Padding="0"
                                Content="&#xE76B;"
                                FontFamily="Segoe MDL2 Assets"/>
                        <controls:ScrollButton x:Name="TEMPLATE_PART_HandwritingCanvasRightScrollButton"
                                Style="{StaticResource ScrollButtonStyle}"
                                Opacity="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Padding="0"
                                Content="&#xE76C;"
                                FontFamily="Segoe MDL2 Assets"/>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="RightScrollButtonStates">
                                <VisualState x:Name="HideRightScrollButton">
                                    <Storyboard BeginTime="0:0:0">
                                        <DoubleAnimation Storyboard.TargetName="TEMPLATE_PART_HandwritingCanvasRightScrollButton"
                                                         Storyboard.TargetProperty="(UIElement.Opacity)"
                                                         To="0"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_HandwritingCanvasRightScrollButton"
                                                                       Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.8" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ShowRightScrollButton">
                                    <Storyboard BeginTime="0:0:0">
                                        <DoubleAnimation Storyboard.TargetName="TEMPLATE_PART_HandwritingCanvasRightScrollButton"
                                                         Storyboard.TargetProperty="(UIElement.Opacity)"
                                                         To="1"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="LeftScrollButtonStates">
                                <VisualState x:Name="HideLeftScrollButton">
                                    <Storyboard BeginTime="0:0:0">
                                        <DoubleAnimation Storyboard.TargetName="TEMPLATE_PART_HandwritingCanvasLeftScrollButton"
                                                         Storyboard.TargetProperty="(UIElement.Opacity)"
                                                         To="0"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_HandwritingCanvasLeftScrollButton"
                                                                       Storyboard.TargetProperty="(UIElement.Visibility)">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.8" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="ShowLeftScrollButton">
                                    <Storyboard BeginTime="0:0:0">
                                        <DoubleAnimation Storyboard.TargetName="TEMPLATE_PART_HandwritingCanvasLeftScrollButton"
                                                         Storyboard.TargetProperty="(UIElement.Opacity)"
                                                         To="1"
                                                         Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
