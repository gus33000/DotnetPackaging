    <!-- TODO: fix styles and states for flower key -->
    <Style TargetType="controls:FlowerKey">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <!-- This {BaseFontSize} is used to determine the font size of {TEMPLATE_PART_FlowerKeyLabel}. This {BaseFontSize} is relative to the length of the key's long side (when the key's long size is equal to 100px, the font size of {TEMPLATE_PART_FlowerKeyLabel} will be {BaseFontSize}). -->
        <Setter Property="BaseFontSize" Value="24px"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <StackPanel x:Name="TEMPLATE_PART_FlowerKeyStackPanel" Background="{ThemeResource WideNarrowChildKeyBackgroundBrush}" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" Orientation="Horizontal" Width="Auto">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_FlowerKeyStackPanel" Storyboard.TargetProperty="UIElement.Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Hidden">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_FlowerKeyStackPanel" Storyboard.TargetProperty="UIElement.Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_FlowerKeyStackPanel" Storyboard.TargetProperty="UIElement.Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ColorAnimation Duration="0" To="{ThemeResource SystemAccentColor}" Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)" Storyboard.TargetName="TEMPLATE_PART_FlowerKeyStackPanel" />
                                        <ColorAnimation Duration="0" To="{ThemeResource SystemColorHighlightTextColor}" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="TEMPLATE_PART_FlowerKeyLabel" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Invalid">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_FlowerKeyStackPanel" Storyboard.TargetProperty="UIElement.Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Collapsed"/>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="TEMPLATE_PART_FlowerKeyBorder" BorderBrush="{ThemeResource SystemColorButtonTextColor}" BorderThickness="2">
                            <TextBlock x:Name="TEMPLATE_PART_FlowerKeyLabel"
                                       Foreground="{ThemeResource SystemColorButtonTextColor}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"
                                       Opacity="1.0"
                                       RenderTransformOrigin="0.5,0.5" />
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

