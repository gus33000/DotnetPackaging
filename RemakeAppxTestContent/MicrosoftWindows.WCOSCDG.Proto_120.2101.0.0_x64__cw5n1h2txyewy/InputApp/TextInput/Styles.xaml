<ResourceDictionary
    x:Class="WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls.Styles"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shellui="using:WindowsInternal.ComposableShell.Experiences.TextInput.Common.ShellUI"
    xmlns:controls="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked.Controls"
    xmlns:textinput="using:WindowsInternal.ComposableShell.Experiences.TextInputUndocked"
    xmlns:suggestionui="using:WindowsInternal.ComposableShell.Experiences.SuggestionUIUndocked"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ControllerSipStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- VK -->
    <Thickness x:Key="KeySpacing">1</Thickness>

    <!-- Child key panel -->
    <x:Int32 x:Key="ChildKeyAnimationDurationMs">100</x:Int32>
    <!-- These control how to scale the size of child keys based on the size of base key; 1.0 means equal to base key dimension -->
    <!-- Values here aligns with SPLASH keyboard -->
    <x:Double x:Key="ChildKeyWidthInUnitKeys">1.0</x:Double>
    <x:Double x:Key="ChildKeyHeightInUnitKeys">1.0</x:Double>
    <x:Double x:Key="NarrowChildAndBubbleKeysWidthInUnitKeys">1.343</x:Double>
    <x:Double x:Key="NarrowChildAndBubbleKeysHeightInUnitKeys">1.158</x:Double>
    <x:Double x:Key="SplitChildAndBubbleKeysWidthInUnitKeys">1.2692</x:Double>
    <x:Double x:Key="SplitChildAndBubbleKeysHeightInUnitKeys">1.2985</x:Double>
    <x:Double x:Key="FullEnhancedChildAndBubbleKeysWidthInUnitKeys">1.343</x:Double>
    <x:Double x:Key="FullEnhancedChildAndBubbleKeysHeightInUnitKeys">1.158</x:Double>
    <x:Double x:Key="HandwritingNarrowChildKeysWidthInUnitKeys">1</x:Double>
    <x:Double x:Key="HandwritingNarrowChildKeysHeightInUnitKeys">1</x:Double>
    <!-- These control how much space in height does SIP occupy-->
    <GridLength x:Key="KeyboardGripperHeight">32</GridLength>
    <GridLength x:Key="KeyboardGridHeight">5.45*</GridLength>
    <GridLength x:Key="KeyboardCandidateBarHeight">1*</GridLength>
    <GridLength x:Key="NarrowKeyboardGridHeight">5.85*</GridLength>
    <!-- NOTE: for wide keyboard this is 1*, however we need to make narrow keyboard CW tall enough to fit the key bubble of the upper key row -->
    <GridLength x:Key="NarrowKeyboardCandidateBarHeight">1.5*</GridLength>
    <!-- NOTE: Two row height is about 2.73* based on the narrow grid height of 5.85* -->
    <GridLength x:Key="NarrowKeyboardCandidateBarTwoRowHeight">2.73*</GridLength>
    <GridLength x:Key="SplitKeyboardGridHeight">4*</GridLength>
    <GridLength x:Key="SplitKeyboardCandidateBarHeight">1*</GridLength>
    <GridLength x:Key="KeyboardGridHeightForHandwriting">3.6*</GridLength>
    <GridLength x:Key="KeyboardGridHeightForCHSHandwriting">4*</GridLength>
    <GridLength x:Key="GazeKeyboardCandidateBarHeight">1.6*</GridLength>
    <!-- for JPN 12key keyboard we need even taller candidate window than in usual narrow to fit all the curve flick petals -->
    <GridLength x:Key="KeyboardGridHeightForJapanese12Key">3.4*</GridLength>
    <!-- After key up, key bubble and key pressed color stays a while. -->
    <Duration x:Key="KeyPressedFeedbackDuration">0:0:0.05</Duration>
    <KeyTime x:Key="KeyPressedFeedbackEndTime">0:0:0.05</KeyTime>
    <x:String x:Key="FontFamilyESIPMDL2">ms-resource:///Files/InputApp/Assets/Fonts/ESIPMDL2.ttf#Emoji SIP MDL2 Assets,/Assets/Fonts/ESIPMDL2.ttf#Emoji SIP MDL2 Assets</x:String>

    <Style x:Key="WideNarrowDefaultKeyStyle" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <!--Lag the transition from pressed to normal so user can process what just happened. -->
                                    <VisualTransition From="Normal" To="Pressed" GeneratedDuration="0:0:0.0" />
                                    <VisualTransition From="Pressed" To="Normal" GeneratedDuration="{StaticResource KeyPressedFeedbackDuration}">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="TEMPLATE_PART_KeyLabel">
                                                <DiscreteObjectKeyFrame KeyTime="{StaticResource KeyPressedFeedbackEndTime}" Value="{ThemeResource WideNarrowKeyLabelBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="TEMPLATE_PART_KeyLabel.Foreground" Value="{ThemeResource WideNarrowKeyPressedLabelBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="TEMPLATE_PART_KeyLabel.Foreground" Value="{ThemeResource WideNarrowKeyHoveredLabelBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverFunctional">
                                    <VisualState.Setters>
                                        <Setter Target="TEMPLATE_PART_KeyLabel.Foreground" Value="{ThemeResource WideNarrowKeyHoveredLabelBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected" >
                                    <VisualState.Setters>
                                        <Setter Target="TEMPLATE_PART_KeyLabel.Foreground" Value="{ThemeResource WideNarrowKeyPressedLabelBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock x:Name="TEMPLATE_PART_KeyLabel" Foreground="{ThemeResource WideNarrowKeyLabelBrush}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TODO: if no differences between styles, combine -->
    <Style x:Key="ErgoDefaultKeyStyle" TargetType="ContentControl" BasedOn="{StaticResource WideNarrowDefaultKeyStyle}"/>

    <!-- TODO: if no differences between styles, combine -->
    <Style x:Key="ErgoFunctionalKeyStyle" TargetType="ContentControl" BasedOn="{StaticResource ErgoDefaultKeyStyle}"/>

