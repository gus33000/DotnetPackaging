                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="TEMPLATE_PART_PasteControlRootGrid"
                                                                       Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource WideNarrowCandidateItemPanelPointerOverBackgroundBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
