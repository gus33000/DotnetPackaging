    <Style x:Key="WideNarrowCategoryListStyle" TargetType="controls:CategoryList" >
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="GutterSizeForSkinTonePicker" Value="0.1"/>
