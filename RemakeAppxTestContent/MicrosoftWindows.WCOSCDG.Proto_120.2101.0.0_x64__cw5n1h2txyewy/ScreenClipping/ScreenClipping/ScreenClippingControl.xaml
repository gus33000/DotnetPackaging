    <!--
        A user control can only have one child, and we want the ScreenClipping experience and Draggable Thumbnail experience
        to be mutually exclusive, so we need to put them both in this grid.
    -->
    <Grid x:ConnectionId='49' x:Name="RootGrid">
        <!--
            We set the flow direction of the root of this control to be left to right. Then apply RTL setting to the
            type selection control. This prevents RTL image clipping issues arising as described in ScreenClippingViewModel.cpp
        -->
        <Grid x:ConnectionId='50' x:Name="ScreenClippingParentGrid" FlowDirection="LeftToRight">
            <Path x:ConnectionId='54'
                x:Name="FreeformScreenClipHiddenPath"
                Style="{StaticResource FreeformScreenClipPathStyle}"
                                                                                             />
            <Grid x:ConnectionId='55'
                x:Name="ScreenshotImageHolder"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
            <!--
                For single screen active scenarios, though we capture fullscreen image
                we only need to show part of it, hence we control stretch and horizontal alignment
                properties from code
            -->
            <Image x:ConnectionId='56'
                x:Name="ScreenshotImage"
                                                                                                        
                VerticalAlignment="Stretch"
                AutomationProperties.AccessibilityView="Raw"
                                                                    
                                                                                
                                                                                 />
            <Rectangle x:ConnectionId='57'
                x:Name="SmokeRect"
                                                                            
                Opacity="0.0"
                Stroke="Transparent"
                StrokeThickness="0"
                                                                                      />
            <Path x:ConnectionId='58'
                x:Name="PathForShowingClipping"
                Opacity="1.0"
                Stroke="Transparent"
                StrokeThickness="0"/>
            <TextBlock x:ConnectionId='59'
                x:Name="Temporary_UndockedValidationMessage"
                Foreground="White"
                                                                             
                                                                                              />
            <!--  todo [jaburnsi] http://osgvsowi/20371487: add x:Loads to all of these to optimize tree  -->
            <Rectangle x:ConnectionId='60'
                x:Name="ScreenshotFlashRectangle"
                Fill="White"
                Opacity="0.0"
                                                                                      />
            <Rectangle x:ConnectionId='61'
                x:Name="ScreenshotFlashRectangleOutline"
                Fill="Transparent"
                Opacity="0.0"
                Stroke="White"
                StrokeThickness="4"
                                                                                      />
            <MediaElement x:ConnectionId='62' x:Name="ScreenshotSoundPlayerElement" Visibility="Collapsed" />

            <Grid x:ConnectionId='63'
                x:Name="FirstRunGrid"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <TextBlock x:ConnectionId='85'
                    x:Name="FirstRunTextBlock"
                    x:Uid="ScreenClippingScreenClipFirstRun"
                    Margin="80"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource SystemControlForegroundChromeWhiteBrush}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextAlignment="Center"
                                                                                       />
            </Grid>

            <!--
                This grid is needed to act as part of 3D transforms. Originally the transform was specified
                on ScreenClippingParentGrid, but moved to here because inkcanvas was throwing
            -->
            <Grid>
                <!--  TODO: http://osgvsowi/20355185 - need to bind visibility to ViewModel  -->
                <Grid.Transform3D>
                    <PerspectiveTransform3D />
                </Grid.Transform3D>
                <Grid x:ConnectionId='70' x:Name="ImageHolderGrid">
                    <local:CompositionShadowControl x:ConnectionId='81'
                        x:Name="ClipDragDropImageShadow"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BlurRadius="48"
                        OffsetX="0"
                        OffsetY="9"
                        ShadowOpacity="0.48"
                                                                                             >
                        <local:CompositionShadowControl.RenderTransform>
                            <CompositeTransform x:ConnectionId='82'
                                x:Name="ClipDragDropImageShadowCompositeTransform"
                                ScaleX="1.0"
                                ScaleY="1.0"
                                TranslateX="0"
                                TranslateY="0" />
                        </local:CompositionShadowControl.RenderTransform>
                        <Image x:ConnectionId='83' x:Name="ClipDragDropImage"                                                                      >
                            <Image.Transform3D>
                                <CompositeTransform3D x:ConnectionId='84' x:Name="ClipDragDropImageTransform3D" />
                            </Image.Transform3D>
                        </Image>
                    </local:CompositionShadowControl>
                </Grid>
                <!--  TODO: http://osgvsowi/20355185 - need to bind visibility to ViewModel  -->
                <local:DecoupledCompositionShadowControl x:ConnectionId='71' x:Name="FreeformInProgressGlowHost" />
                <local:CompositionShadowControl x:ConnectionId='72' x:Name="ScreenClipRectangleGlow" Style="{StaticResource InkGlowStyle}">
                    <local:CompositionShadowControl.Transform3D>
                        <CompositeTransform3D x:ConnectionId='79' x:Name="ScreenClipRectangleGlowTransform3D" />
                    </local:CompositionShadowControl.Transform3D>
                    <Rectangle x:ConnectionId='80'
                        x:Name="ScreenClipRectangle"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="Transparent"
                        Stroke="White"
                                                                                                   
                                                                                                  />
                </local:CompositionShadowControl>
                <local:CompositionShadowControl x:ConnectionId='73' x:Name="ScreenClipFreeformGlow" Style="{StaticResource InkGlowStyle}">
                    <Path x:ConnectionId='77'
                        x:Name="FreeformScreenClipPath"
                        Style="{StaticResource FreeformScreenClipPathStyle}"
                                                                                                    >
                        <Path.Transform3D>
                            <CompositeTransform3D x:ConnectionId='78' x:Name="FreeformScreenClipPathTransform3D" />
                        </Path.Transform3D>
                    </Path>
                </local:CompositionShadowControl>
                <Grid x:ConnectionId='74' x:Name="ScreenClipActionsHolderGrid" Opacity="0.0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:ConnectionId='75' x:Name="ScreenClipActionsTranslateTransform" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <local:ScreenClipActionsControl x:ConnectionId='76'
                        x:Name="ScreenClipActions"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                                                                                               
                                                                                                />
                </Grid>
            </Grid>
            <InkCanvas x:ConnectionId='64' x:Name="ScreenClipInkCanvas"                                                                 />
            <Grid x:ConnectionId='65'
                x:Name="ClippingSelectionControlGrid"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
                <Grid.Clip>
                    <RectangleGeometry x:ConnectionId='66'                                                                             />
                </Grid.Clip>
                <Grid x:ConnectionId='67'
                    x:Name="ClippingSelectionControlClippingGrid"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                    <local:ScreenClippingTypeSelectionControl x:ConnectionId='68'
                        x:Name="ClippingTypeSelectionControl"
                        HorizontalAlignment="Center"
                                                                                                                                       
                                                                                              >
                        <local:ScreenClippingTypeSelectionControl.RenderTransform>
                            <TranslateTransform x:ConnectionId='69' x:Name="ClippingTypeSelectionControlTranslateTransform" Y="-48" />
                        </local:ScreenClippingTypeSelectionControl.RenderTransform>
                    </local:ScreenClippingTypeSelectionControl>
                </Grid>
            </Grid>
        </Grid>
        <Canvas x:ConnectionId='51'
            x:Name="ThumbnailCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <local:DraggableThumbnailControl x:ConnectionId='52' x:Name="DraggableThumbnail" Visibility="Collapsed" />
            <Image x:ConnectionId='53'
                x:Name="ClippedImage"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw">
            </Image>
        </Canvas>
    </Grid>
</UserControl>

