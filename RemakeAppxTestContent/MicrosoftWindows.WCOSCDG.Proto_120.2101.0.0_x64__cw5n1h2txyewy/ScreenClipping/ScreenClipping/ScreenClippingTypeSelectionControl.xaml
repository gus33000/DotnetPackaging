<UserControl x:ConnectionId='1'
    x:Class="WindowsInternal.ComposableShell.Experiences.ScreenClipping.ScreenClippingTypeSelectionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsInternal.ComposableShell.Experiences.ScreenClipping"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    TabNavigation="Local"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SelectionControlButtonForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SelectionControlButtonBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SelectionControlPointerOverButtonForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SelectionControlPointerOverButtonBackgroundBrush" Color="{StaticResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="SelectionControlPointerPressedButtonForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SelectionControlPointerPressedButtonBackgroundBrush" Color="{StaticResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="SelectionControlCheckedButtonForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="SelectionControlCheckedButtonBackgroundBrush" Color="{ThemeResource SystemAccentColor}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="SelectionControlButtonForegroundBrush" Color="{ThemeResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="SelectionControlButtonBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SelectionControlPointerOverButtonForegroundBrush" Color="{StaticResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="SelectionControlPointerOverButtonBackgroundBrush" Color="{StaticResource SystemBaseMediumLowColor}" />
                    <SolidColorBrush x:Key="SelectionControlPointerPressedButtonForegroundBrush" Color="{StaticResource SystemBaseHighColor}" />
                    <SolidColorBrush x:Key="SelectionControlPointerPressedButtonBackgroundBrush" Color="{StaticResource SystemBaseMediumLowColor}" />
                    <SolidColorBrush x:Key="SelectionControlCheckedButtonForegroundBrush" Color="{ThemeResource SystemChromeWhiteColor}" />
                    <SolidColorBrush x:Key="SelectionControlCheckedButtonBackgroundBrush" Color="{ThemeResource SystemAccentColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="SelectionControlButtonFontFamily">Segoe MDL2 Assets</FontFamily>
            <FontFamily x:Key="ScreenClipFullscreenFontFamily">Segoe MDL2 Assets</FontFamily>
            <Thickness x:Key="SelectionControlButtonBorderThickness">0</Thickness>
            <x:Double x:Key="SelectionControlButtonFontSize">16</x:Double>
            <x:Double x:Key="SelectionControlButtonWidth">48</x:Double>
            <x:Double x:Key="SelectionControlButtonHeight">48</x:Double>
            <x:Double x:Key="FlyoutThemeMaxHeight">758</x:Double>
            <x:Double x:Key="FlyoutThemeMaxWidth">456</x:Double>
            <x:Double x:Key="FlyoutThemeMinHeight">32</x:Double>
            <x:Double x:Key="FlyoutThemeMinWidth">96</x:Double>
            <x:Double x:Key="FlyoutThemeTouchMinWidth">240</x:Double>
            <Thickness x:Key="FlyoutBorderThemeThickness">1</Thickness>
            <Thickness x:Key="FlyoutContentThemeMargin">0,0,0,0</Thickness>
            <Thickness x:Key="FlyoutContentThemePadding">0,8,0,8</Thickness>

            <Style x:Key="ScreenClippingSelectionControlToggleButtonType" TargetType="ToggleButton">
                <Setter Property="Background" Value="{StaticResource SelectionControlButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SelectionControlButtonForegroundBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SelectionControlButtonBorderThickness}" />
                <Setter Property="FontFamily" Value="{StaticResource SelectionControlButtonFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource SelectionControlButtonFontSize}" />
                <Setter Property="Width" Value="{StaticResource SelectionControlButtonWidth}" />
                <Setter Property="Height" Value="{StaticResource SelectionControlButtonHeight}" />
                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlPointerOverButtonBackgroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlPointerOverButtonForegroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlPointerPressedButtonBackgroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlPointerPressedButtonForegroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <PointerDownThemeAnimation Storyboard.TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlCheckedButtonBackgroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlCheckedButtonForegroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlCheckedButtonBackgroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlCheckedButtonForegroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlCheckedButtonBackgroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlCheckedButtonForegroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScreenClippingSelectionControlButtonType" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SelectionControlButtonBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource SelectionControlButtonForegroundBrush}" />
                <Setter Property="BorderThickness" Value="{StaticResource SelectionControlButtonBorderThickness}" />
                <Setter Property="FontFamily" Value="{StaticResource SelectionControlButtonFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource SelectionControlButtonFontSize}" />
                <Setter Property="Width" Value="{StaticResource SelectionControlButtonWidth}" />
                <Setter Property="Height" Value="{StaticResource SelectionControlButtonHeight}" />
                <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                                <ContentPresenter
                                    x:Name="ContentPresenter"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    AutomationProperties.AccessibilityView="Raw"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlPointerOverButtonBackgroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlPointerOverButtonForegroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlPointerPressedButtonBackgroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SelectionControlPointerPressedButtonForegroundBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <PointerDownThemeAnimation Storyboard.TargetName="RootGrid" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ScreenClipDividerType" TargetType="Rectangle">
                <Setter Property="Fill" Value="{StaticResource SelectionControlButtonForegroundBrush}" />
                <Setter Property="Width" Value="1" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Opacity" Value="0.2" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:ConnectionId='19'
        x:Name="TypeSelectionHolderGrid"
        Background="{StaticResource SystemControlAcrylicWindowMediumHighBrush}"
        BorderBrush="{ThemeResource SystemControlForegroundTransparentBrush}"
        BorderThickness="1">
        <StackPanel Orientation="Horizontal" XYFocusKeyboardNavigation="Enabled">
            <local:ScreenClippingToggleButton x:ConnectionId='20'
                x:Name="RectangularClip"
                x:Uid="ScreenClippingRectangularClip"
                x:Load="False"                                                 
                                                                    
                Content="&#xF407;"
                                                                             
                                                                                                
                Style="{StaticResource ScreenClippingSelectionControlToggleButtonType}"
                                                                    />
            <local:ScreenClippingToggleButton x:ConnectionId='21'
                x:Name="FreeformClip"
                x:Uid="ScreenClippingFreeformClip"
                x:Load="False"                                                
                                                                 
                Content="&#xF408;"
                                                                          
                                                                                                
                Style="{StaticResource ScreenClippingSelectionControlToggleButtonType}"
                                                                 />
            <local:ScreenClippingToggleButton x:ConnectionId='22'
                x:Name="WindowClip"
                x:Uid="ScreenClippingWindowClip"
                x:Load="False"                                              
                                                               
                Content="&#xF7ED;"
                                                                        
                                                                                                
                Style="{StaticResource ScreenClippingSelectionControlToggleButtonType}"
                                                               />
            <Button x:ConnectionId='23'
                x:Name="FullscreenClip"
                x:Uid="ScreenClippingFullscreenClip"
                x:Load="False"                                                  
                                                   
                                                                                                
                Style="{StaticResource ScreenClippingSelectionControlButtonType}"
                                                                        
                Content="&#xE9A6;"/>
            <Rectangle Style="{StaticResource ScreenClipDividerType}" />
            <Button x:ConnectionId='24'
                x:Name="ScreenClippingClose"
                x:Uid="ScreenClippingClose"
                                                                         
                Content="&#xEDAE;"
                                                                                                
                Style="{StaticResource ScreenClippingSelectionControlButtonType}" />
        </StackPanel>
    </Grid>
</UserControl>

