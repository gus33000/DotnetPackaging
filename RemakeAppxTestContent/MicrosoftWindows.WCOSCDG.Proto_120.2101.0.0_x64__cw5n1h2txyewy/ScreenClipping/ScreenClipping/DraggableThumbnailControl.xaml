<UserControl
    x:Class="WindowsInternal.ComposableShell.Experiences.ScreenClipping.DraggableThumbnailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="CustomThumbnailControl"
    Width="108"
    Height="74"
    d:DesignHeight="400"
    d:DesignWidth="400"
    Opacity="0"
    mc:Ignorable="d">

    <UserControl.RenderTransform>
        <TranslateTransform x:ConnectionId='2' x:Name="DragTranslation" />
    </UserControl.RenderTransform>

    <Grid x:ConnectionId='3'
        x:Name="RootGrid"
        Background="{ThemeResource SystemControlAcrylicWindowBrush}"
        CornerRadius="3"
        ManipulationMode="TranslateX,TranslateY"
                                                        
                                                          
                                                              >
        <!--  seems like a useless thing to have padding be zero, right? WRONG!  -->
        <Image x:ConnectionId='4'
            x:Name="ThumbnailImage"
            Width="100"
            Height="66"/>
        <Button x:ConnectionId='5'
            x:Name="CloseButton"
            Width="20"
            Height="20"
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AccessKey="C"
            Background="{ThemeResource SystemControlAcrylicWindowBrush}"
                                     
            Content="&#59540;"
            CornerRadius="3"
            FontFamily="Segoe MDL2 Assets"
            FontSize="12" />
    </Grid>
</UserControl>


