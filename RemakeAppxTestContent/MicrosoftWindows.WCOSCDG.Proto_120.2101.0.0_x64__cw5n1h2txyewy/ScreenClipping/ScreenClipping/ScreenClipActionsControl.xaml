<UserControl x:ConnectionId='1'
    x:Class="WindowsInternal.ComposableShell.Experiences.ScreenClipping.ScreenClipActionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsInternal.ComposableShell.Experiences.ScreenClipping"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    TabNavigation="Cycle"
    mc:Ignorable="d">

    <UserControl.Resources>
        <x:Double x:Key="ScreenClippingActionsControlButtonWidth">48</x:Double>
        <x:Double x:Key="ScreenClippingActionsControlButtonHeight">48</x:Double>
        <Style x:Key="ScreenClippingActionsControlButtonType" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="{StaticResource ScreenClippingActionsControlButtonWidth}" />
            <Setter Property="Height" Value="{StaticResource ScreenClippingActionsControlButtonHeight}" />
            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
        </Style>
        <Style x:Key="ScreenClippingActionsControlIconStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5" />
        </Style>
        <Storyboard x:ConnectionId='2' x:Name="CopyToClipboardSuccessAnimation">
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="CopyToClipboardText"
                Storyboard.TargetProperty="(UIElement.Opacity)"
                Duration="0:0:1.433">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.33,0.0 0.67,1.0"
                    KeyTime="0:0:0.133"
                    Value="0.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.3" Value="0.0" />
                <SplineDoubleKeyFrame
                    KeySpline="1.0,0.0 1.0,1.0"
                    KeyTime="0:0:1.433"
                    Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="CopyToClipboardTextScaleTransform"
                Storyboard.TargetProperty="(ScaleX)"
                Duration="0:0:1.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.13,0.0 0.0,1.0"
                    KeyTime="0:0:0.133"
                    Value="0.273" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.167" Value="0.273" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="CopyToClipboardTextScaleTransform"
                Storyboard.TargetProperty="(ScaleY)"
                Duration="0:0:1.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1.0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.13,0.0 0.0,1.0"
                    KeyTime="0:0:0.133"
                    Value="0.273" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.167" Value="0.273" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.2" Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="CopyToClipboardSuccessText"
                Storyboard.TargetProperty="(UIElement.Opacity)"
                Duration="0:0:1.3">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.133" Value="0.0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.33,0.0 0.67,1.0"
                    KeyTime="0:0:0.267"
                    Value="1.0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.167" Value="1.0" />
                <SplineDoubleKeyFrame
                    KeySpline="1.0,0.0 0.98,1.0"
                    KeyTime="0:0:1.3"
                    Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="CopyToClipboardSuccessTextScaleTransform"
                Storyboard.TargetProperty="(ScaleX)"
                Duration="0:0:0.333">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.133" Value="0.385" />
                <SplineDoubleKeyFrame
                    KeySpline="0.39,0.0 0.63,1.0"
                    KeyTime="0:0:0.267"
                    Value="1.146" />
                <SplineDoubleKeyFrame
                    KeySpline="0.55,0.0 0.02,1.0"
                    KeyTime="0:0:0.333"
                    Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                Storyboard.TargetName="CopyToClipboardSuccessTextScaleTransform"
                Storyboard.TargetProperty="(ScaleY)"
                Duration="0:0:0.333">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.133" Value="0.385" />
                <SplineDoubleKeyFrame
                    KeySpline="0.39,0.0 0.63,1.0"
                    KeyTime="0:0:0.267"
                    Value="1.146" />
                <SplineDoubleKeyFrame
                    KeySpline="0.55,0.0 0.02,1.0"
                    KeyTime="0:0:0.333"
                    Value="1.0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <FontFamily x:Key="SteeringWheelGlyphFont">/Assets/Fonts/strgmdl2.2.42.ttf#Steering Wheel MDL2 Assets</FontFamily>
    </UserControl.Resources>
    <Grid x:ConnectionId='3' x:Name="ScreenClipActionsControlGrid">
        <StackPanel Orientation="Horizontal">
            <Button x:ConnectionId='4'
                x:Name="CopyToWhiteboardButton"
                x:Uid="ScreenClippingCopyToWhiteboard"
                                                                          
                Style="{StaticResource ScreenClippingActionsControlButtonType}"
                                                                          
                                                                               >
                <TextBlock x:ConnectionId='13' x:Name="CopyToWhiteboardText" Text="&#xE929;" />
            </Button>
            <Grid>
                <Button x:ConnectionId='7'
                    x:Name="CopyToClipboardButton"
                    x:Uid="ScreenClippingCopyToClipboard"
                                                                             
                    Style="{StaticResource ScreenClippingActionsControlButtonType}"
                                                                             >
                    <Grid>
                        <TextBlock x:ConnectionId='11' x:Name="CopyToClipboardText" Text="&#xE16F;">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:ConnectionId='12' x:Name="CopyToClipboardTextScaleTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Button>
                <Grid x:ConnectionId='8'
                    x:Name="CopyToClipboardSuccessGrid"
                    Width="{StaticResource ScreenClippingActionsControlButtonWidth}"
                    Height="{StaticResource ScreenClippingActionsControlButtonHeight}"
                    Background="Transparent"
                    IsHitTestVisible="True"
                                                                                
                    Visibility="Collapsed">
                    <TextBlock x:ConnectionId='9'
                        x:Name="CopyToClipboardSuccessText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.0"
                        Style="{StaticResource ScreenClippingActionsControlIconStyle}"
                        Text="&#xE73E;">
                        <TextBlock.RenderTransform>
                            <ScaleTransform x:ConnectionId='10' x:Name="CopyToClipboardSuccessTextScaleTransform" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>
            <Button x:ConnectionId='5'
                x:Name="ShareButton"
                x:Uid="ScreenClippingShare"
                                                               
                Style="{StaticResource ScreenClippingActionsControlButtonType}"
                                                               
                                                                    >
                <TextBlock x:ConnectionId='6' x:Name="ShareText" Text="&#xE72D;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

